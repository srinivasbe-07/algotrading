//@version=6
indicator("SMC - Smart Money Concepts", overlay=true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

//  Final combined VISUALIZATION indicator — Parts 1–6, no signals/alerts.
//  (Entry/exit signals + webhook alerts live in the separate Part 7 file.)
//  Parts: 1 Swing H/L · 2 Market Structure · 3 FVG · 4 Order Blocks ·
//         5 Liquidity (BSL/SSL, EQH/EQL, sweeps, session levels) ·
//         6 Premium/Discount (HIDDEN by default).

// ── Display toggles ───────────────────────────────────────────────
showSwings = input.bool(false, "Show raw swing H/L labels")

// ══════════════════════════════════════════════════════════════════
//  PART 1 — Swing Highs & Lows
// ══════════════════════════════════════════════════════════════════

isInside  = high < high[1] and low > low[1]
isBullish = not isInside and close > open
isBearish = not isInside and close < open

pivotLow  = ta.pivotlow(low,  1, 1)
pivotHigh = ta.pivothigh(high, 1, 1)

var float   pendingLow      = na
var int     pendingLowBar   = -1
var int     bullAfterLow    = 0
var float   maxHighSinceLow = na
var label[] bullCountLabels = array.new<label>()

var float   pendingHigh     = na
var int     pendingHighBar  = -1
var int     bearAfterHigh   = 0
var float   minLowSinceHigh = na
var label[] bearCountLabels = array.new<label>()

var int     maxSwings       = 5
var float[] swingHighPrices = array.new<float>()
var int[]   swingHighBars   = array.new<int>()
var float[] swingLowPrices  = array.new<float>()
var int[]   swingLowBars    = array.new<int>()

// Minor (raw) pivots — used by Part 4 for liquidity-grab detection
var int     maxMinor        = 10
var float[] minorHighPrices = array.new<float>()
var int[]   minorHighBars   = array.new<int>()
var float[] minorLowPrices  = array.new<float>()
var int[]   minorLowBars    = array.new<int>()

var bool swingLowJustConfirmed  = false
var bool swingHighJustConfirmed = false
swingLowJustConfirmed  := false
swingHighJustConfirmed := false

if not na(pivotHigh)
    array.unshift(minorHighPrices, pivotHigh)
    array.unshift(minorHighBars,   bar_index[1])
    if array.size(minorHighPrices) > maxMinor
        array.pop(minorHighPrices)
        array.pop(minorHighBars)
if not na(pivotLow)
    array.unshift(minorLowPrices, pivotLow)
    array.unshift(minorLowBars,   bar_index[1])
    if array.size(minorLowPrices) > maxMinor
        array.pop(minorLowPrices)
        array.pop(minorLowBars)

if not na(pendingLow) and close < pendingLow
    for lbl in bullCountLabels
        label.delete(lbl)
    array.clear(bullCountLabels)
    pendingLow      := na
    pendingLowBar   := -1
    bullAfterLow    := 0
    maxHighSinceLow := na

if not na(pendingHigh) and close > pendingHigh
    for lbl in bearCountLabels
        label.delete(lbl)
    array.clear(bearCountLabels)
    pendingHigh     := na
    pendingHighBar  := -1
    bearAfterHigh   := 0
    minLowSinceHigh := na

if not na(pivotLow) and (na(pendingLow) or pivotLow < pendingLow)
    if not na(pendingLow)
        for lbl in bullCountLabels
            label.delete(lbl)
        array.clear(bullCountLabels)
    pendingLow      := pivotLow
    pendingLowBar   := bar_index[1]
    maxHighSinceLow := high[1]
    bullAfterLow    := 0
    if close[1] > open[1]
        bullAfterLow := 1

if not na(pivotHigh) and (na(pendingHigh) or pivotHigh > pendingHigh)
    if not na(pendingHigh)
        for lbl in bearCountLabels
            label.delete(lbl)
        array.clear(bearCountLabels)
    pendingHigh     := pivotHigh
    pendingHighBar  := bar_index[1]
    minLowSinceHigh := low[1]
    bearAfterHigh   := 0
    if close[1] < open[1]
        bearAfterHigh := 1

if not na(pendingLow)
    if isBullish and close > maxHighSinceLow
        bullAfterLow    += 1
        maxHighSinceLow := high
        if bullAfterLow >= 3
            if showSwings
                label.new(pendingLowBar, pendingLow, "L",
                          color=color.new(color.white,100), textcolor=color.red,
                          size=size.normal, style=label.style_none, yloc=yloc.belowbar)
            array.unshift(swingLowPrices, pendingLow)
            array.unshift(swingLowBars,   pendingLowBar)
            if array.size(swingLowPrices) > maxSwings
                array.pop(swingLowPrices)
                array.pop(swingLowBars)
            array.clear(bullCountLabels)
            swingLowJustConfirmed := true
            pendingLow      := na
            pendingLowBar   := -1
            bullAfterLow    := 0
            maxHighSinceLow := na
    else
        maxHighSinceLow := math.max(maxHighSinceLow, high)

if not na(pendingHigh)
    if isBearish and close < minLowSinceHigh
        bearAfterHigh   += 1
        minLowSinceHigh := low
        if bearAfterHigh >= 3
            if showSwings
                label.new(pendingHighBar, pendingHigh, "H",
                          color=color.new(color.white,100), textcolor=color.green,
                          size=size.normal, style=label.style_none, yloc=yloc.abovebar)
            array.unshift(swingHighPrices, pendingHigh)
            array.unshift(swingHighBars,   pendingHighBar)
            if array.size(swingHighPrices) > maxSwings
                array.pop(swingHighPrices)
                array.pop(swingHighBars)
            array.clear(bearCountLabels)
            swingHighJustConfirmed := true
            pendingHigh     := na
            pendingHighBar  := -1
            bearAfterHigh   := 0
            minLowSinceHigh := na
    else
        minLowSinceHigh := math.min(minLowSinceHigh, low)

// ══════════════════════════════════════════════════════════════════
//  PART 2 — Market Structure (BOS / CHoCH)
// ══════════════════════════════════════════════════════════════════

colBOS       = input.color(color.blue,  "BOS label",                       group = "Structure")
colUp        = input.color(color.green, "Bullish level / CHoCH",           group = "Structure")
colDown      = input.color(color.red,   "Bearish level / CHoCH",           group = "Structure")
showStructHL = input.bool(true, "Show structure H/L labels",               group = "Structure")
showTrendBg  = input.bool(true, "Trend background (green up / red down)",   group = "Structure")

var string trend             = "none"
var float  refHigh           = na
var float  refLow            = na
var int    refHighBar        = -1
var int    refLowBar         = -1
var int    eventBar          = -1
var bool   waitingForRefHigh = false
var bool   waitingForRefLow  = false
var label  refHighLbl        = na
var label  refLowLbl         = na
var int    obBaseBar         = -1

if trend == "none" and array.size(swingHighPrices) > 0 and array.size(swingLowPrices) > 0
    refHigh    := array.get(swingHighPrices, 0)
    refHighBar := array.get(swingHighBars,   0)
    refLow     := array.get(swingLowPrices,  0)
    refLowBar  := array.get(swingLowBars,    0)
    trend      := refHighBar > refLowBar ? "up" : "down"
    if showStructHL
        refHighLbl := label.new(refHighBar, refHigh, "H", color = color.new(color.white, 100), textcolor = colUp, size = size.small, style = label.style_none, yloc = yloc.abovebar)
        refLowLbl  := label.new(refLowBar,  refLow,  "L", color = color.new(color.white, 100), textcolor = colDown, size = size.small, style = label.style_none, yloc = yloc.belowbar)

if waitingForRefHigh and swingHighJustConfirmed and array.size(swingHighBars) > 0 and array.get(swingHighBars, 0) > eventBar
    refHigh           := array.get(swingHighPrices, 0)
    refHighBar        := array.get(swingHighBars,   0)
    waitingForRefHigh := false
    if showStructHL
        refHighLbl := label.new(refHighBar, refHigh, "H", color = color.new(color.white, 100), textcolor = colUp, size = size.small, style = label.style_none, yloc = yloc.abovebar)

if waitingForRefLow and swingLowJustConfirmed and array.size(swingLowBars) > 0 and array.get(swingLowBars, 0) > eventBar
    refLow           := array.get(swingLowPrices, 0)
    refLowBar        := array.get(swingLowBars,   0)
    waitingForRefLow := false
    if showStructHL
        refLowLbl := label.new(refLowBar, refLow, "L", color = color.new(color.white, 100), textcolor = colDown, size = size.small, style = label.style_none, yloc = yloc.belowbar)

bool   eventFired = false
bool   goingUp    = false
string eventType  = ""

if trend != "none"
    if not na(refHigh) and close > refHigh
        eventFired := true
        goingUp    := true
        eventType  := trend == "up" ? "BOS" : "CHoCH"
    if not na(refLow) and close < refLow
        eventFired := true
        goingUp    := false
        eventType  := trend == "down" ? "BOS" : "CHoCH"

if eventFired
    col          = eventType == "BOS" ? colBOS : (goingUp ? colUp : colDown)
    float lvl    = goingUp ? refHigh : refLow
    int   lvlBar = goingUp ? refHighBar : refLowBar
    int   midBar = int(math.avg(lvlBar, bar_index))

    line.new(lvlBar, lvl, bar_index, lvl, color = col, width = 2, style = line.style_dotted)
    label.new(midBar, lvl, eventType, color = color.new(color.white, 100), textcolor = col, size = size.small, style = label.style_none)

    eventBar := bar_index

    if goingUp
        trend := "up"
        float scanLow    = low
        int   scanLowBar = bar_index
        for i = 0 to bar_index - refHighBar
            if low[i] < scanLow
                scanLow    := low[i]
                scanLowBar := bar_index - i
        refLow    := scanLow
        refLowBar := scanLowBar
        obBaseBar := scanLowBar
        if showStructHL
            refLowLbl := label.new(refLowBar, refLow, "L", color = color.new(color.white, 100), textcolor = colDown, size = size.small, style = label.style_none, yloc = yloc.belowbar)
        refHigh           := na
        refHighBar        := -1
        refHighLbl        := na
        waitingForRefHigh := true
        waitingForRefLow  := false
    else
        trend := "down"
        float scanHigh    = high
        int   scanHighBar = bar_index
        for i = 0 to bar_index - refLowBar
            if high[i] > scanHigh
                scanHigh    := high[i]
                scanHighBar := bar_index - i
        refHigh    := scanHigh
        refHighBar := scanHighBar
        obBaseBar  := scanHighBar
        if showStructHL
            refHighLbl := label.new(refHighBar, refHigh, "H", color = color.new(color.white, 100), textcolor = colUp, size = size.small, style = label.style_none, yloc = yloc.abovebar)
        refLow            := na
        refLowBar         := -1
        refLowLbl         := na
        waitingForRefLow  := true
        waitingForRefHigh := false

bgcolor(showTrendBg ? (trend == "up" ? color.new(colUp, 92) : trend == "down" ? color.new(colDown, 92) : na) : na)

// ══════════════════════════════════════════════════════════════════
//  PART 3 — Fair Value Gaps (FVG)
//   Bullish: high[2] < low[0] AND close[1] > high[2]
//   Bearish: low[2]  > high[0] AND close[1] < low[2]
// ══════════════════════════════════════════════════════════════════

// LuxAlgo style — 3-candle gap, auto threshold, two stacked boxes, delete on mitigation.
showFvgBull  = input.bool(false, "Show bullish FVG",                group = "Fair Value Gaps")
showFvgBear  = input.bool(false, "Show bearish FVG",                group = "Fair Value Gaps")
colFvgBull   = input.color(color.new(#00ff68, 70), "Bullish FVG", group = "Fair Value Gaps")
colFvgBear   = input.color(color.new(#ff0008, 70), "Bearish FVG", group = "Fair Value Gaps")
colFvgMit    = input.color(color.new(color.gray,  85), "Mitigated FVG", group = "Fair Value Gaps")
maxFvg       = input.int(20, "Max FVG boxes", minval = 1, group = "Fair Value Gaps")
fvgExtend    = input.int(10, "FVG box extend (bars)", minval = 0, group = "Fair Value Gaps")
hideFvgMitig = input.bool(true,  "Delete FVG on mitigation (LuxAlgo)", group = "Fair Value Gaps")
fvgUseThresh = input.bool(true,  "Auto threshold (LuxAlgo)", group = "Fair Value Gaps")

type fvg
    float top
    float bottom
    int   bias
    box   bx1
    box   bx2
    bool  mitigated = false

var fvg[] fvgs = array.new<fvg>()

trimFVG() =>
    while array.size(fvgs) > maxFvg
        old = array.shift(fvgs)
        box.delete(old.bx1)
        box.delete(old.bx2)

deltaPct  = (close[1] - open[1]) / (open[1] * 100)
threshold = fvgUseThresh ? ta.cum(math.abs(deltaPct)) / bar_index * 2 : 0.0

bullFVG = high[2] < low[0] and close[1] > high[2] and (not fvgUseThresh or  deltaPct > threshold)
bearFVG = low[2]  > high[0] and close[1] < low[2]  and (not fvgUseThresh or -deltaPct > threshold)

if bullFVG and showFvgBull
    float t = low[0]                       // upper edge
    float b = high[2]                      // lower edge (far edge)
    float m = math.avg(t, b)
    box   b1 = box.new(bar_index - 1, t, bar_index + fvgExtend, m, border_color = na, bgcolor = colFvgBull)
    box   b2 = box.new(bar_index - 1, m, bar_index + fvgExtend, b, border_color = na, bgcolor = colFvgBull)
    array.push(fvgs, fvg.new(t, b, 1, b1, b2))
    trimFVG()

if bearFVG and showFvgBear
    float t = high[0]                      // lower edge
    float b = low[2]                       // upper edge (far edge)
    float m = math.avg(t, b)
    box   b1 = box.new(bar_index - 1, t, bar_index + fvgExtend, m, border_color = na, bgcolor = colFvgBear)
    box   b2 = box.new(bar_index - 1, m, bar_index + fvgExtend, b, border_color = na, bgcolor = colFvgBear)
    array.push(fvgs, fvg.new(t, b, -1, b1, b2))
    trimFVG()

if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        f = array.get(fvgs, i)
        if not f.mitigated
            box.set_right(f.bx1, bar_index + fvgExtend)
            box.set_right(f.bx2, bar_index + fvgExtend)
            touched = f.bias == 1 ? low < f.bottom : high > f.top   // LuxAlgo mitigation
            if touched
                f.mitigated := true
                if hideFvgMitig
                    box.delete(f.bx1)
                    box.delete(f.bx2)
                    array.remove(fvgs, i)
                else
                    box.set_bgcolor(f.bx1, colFvgMit)
                    box.set_bgcolor(f.bx2, colFvgMit)
                    box.set_right(f.bx1, bar_index)
                    box.set_right(f.bx2, bar_index)

// ══════════════════════════════════════════════════════════════════
//  PART 4 — Order Blocks (OB)
// ══════════════════════════════════════════════════════════════════

// LuxAlgo style — one OB stored per structure break, anchored to the leg's
// volatility-adjusted extreme candle; removed on mitigation.
showOB       = input.bool(true,    "Show order blocks",                                 group = "Order Blocks")
obCount      = input.int(5,        "Order blocks to show",  minval = 1, maxval = 20,    group = "Order Blocks")
obFilter     = input.string("Atr", "Order block filter",    options = ["Atr", "Cumulative Mean Range"], group = "Order Blocks")
obMitigation = input.string("High/Low", "Order block mitigation", options = ["Close", "High/Low"],      group = "Order Blocks")
colBull      = input.color(color.new(#1848cc, 80), "Bullish OB", group = "Order Blocks")
colBear      = input.color(color.new(#b22833, 80), "Bearish OB", group = "Order Blocks")

atrMeasureOB      = ta.atr(200)
volatilityMeasure = obFilter == "Atr" ? atrMeasureOB : ta.cum(ta.tr) / bar_index

type ob
    float top
    float bottom
    int   bias
    box   bx

var ob[] obs = array.new<ob>()

// Store ONE OB at the leg's parsed extreme candle on each structure break
if eventFired and showOB and obBaseBar >= 0
    int   baseOff = bar_index - obBaseBar
    bool  volBar  = (high[baseOff] - low[baseOff]) >= 2 * volatilityMeasure[baseOff]
    float obTop   = volBar ? low[baseOff]  : high[baseOff]    // LuxAlgo parsedHigh
    float obBot   = volBar ? high[baseOff] : low[baseOff]     // LuxAlgo parsedLow
    color obCol   = goingUp ? colBull : colBear
    box   obBx    = box.new(obBaseBar, obTop, bar_index, obBot, border_color = obCol, bgcolor = obCol)
    array.unshift(obs, ob.new(obTop, obBot, goingUp ? 1 : -1, obBx))
    while array.size(obs) > obCount
        old = array.pop(obs)
        box.delete(old.bx)

// Extend live OBs; remove on mitigation (LuxAlgo deleteOrderBlocks)
bearMitSrc = obMitigation == "Close" ? close : high
bullMitSrc = obMitigation == "Close" ? close : low
if array.size(obs) > 0
    for i = array.size(obs) - 1 to 0
        o = array.get(obs, i)
        box.set_right(o.bx, bar_index)
        bool mit = o.bias == -1 ? bearMitSrc > o.top : bullMitSrc < o.bottom
        if mit
            box.delete(o.bx)
            array.remove(obs, i)

// ══════════════════════════════════════════════════════════════════
//  PART 5.1 — Swing Liquidity (BSL / SSL)  +  5.3 sweep markers
// ══════════════════════════════════════════════════════════════════

showBSL    = input.bool(true,  "Show buy-side liquidity (BSL)",  group = "Liquidity")
showSSL    = input.bool(true,  "Show sell-side liquidity (SSL)", group = "Liquidity")
showLiqLbl = input.bool(true,  "Show BSL/SSL text labels",       group = "Liquidity")
colBSL    = input.color(color.new(color.teal,   0), "BSL line",        group = "Liquidity")
colSSL    = input.color(color.new(color.maroon, 0), "SSL line",        group = "Liquidity")
colTaken  = input.color(color.new(color.gray,  40), "Taken liquidity", group = "Liquidity")
maxLiq    = input.int(12, "Max liquidity lines", minval = 1, group = "Liquidity")
hideTaken = input.bool(false, "Hide taken liquidity", group = "Liquidity")

showSweep = input.bool(true, "Mark liquidity sweeps", group = "Sweeps")
colSweep  = input.color(color.new(color.orange, 0), "Sweep marker", group = "Sweeps")
sweepTag  = input.string("x", "Sweep marker text", options = ["x", "SWEEP", "✕"], group = "Sweeps")

drawSweep(int bias, float wick) =>
    if showSweep
        label.new(bar_index, wick, sweepTag, color = color(na), textcolor = colSweep, style = bias == 1 ? label.style_label_down : label.style_label_up, size = size.tiny)

type liq
    float level
    int   bias
    line  ln
    label lb = na
    bool  taken = false

var liq[] liqs = array.new<liq>()

trimLiq() =>
    while array.size(liqs) > maxLiq
        old = array.shift(liqs)
        line.delete(old.ln)
        label.delete(old.lb)

if swingHighJustConfirmed and showBSL and array.size(swingHighPrices) > 0
    lvl = array.get(swingHighPrices, 0)
    bar = array.get(swingHighBars,   0)
    ln  = line.new(bar, lvl, bar_index, lvl, color = colBSL, width = 1)
    lb  = showLiqLbl ? label.new(bar_index, lvl, "BSL", color = color(na), textcolor = colBSL, style = label.style_label_left, size = size.tiny) : na
    array.push(liqs, liq.new(lvl, 1, ln, lb))
    trimLiq()

if swingLowJustConfirmed and showSSL and array.size(swingLowPrices) > 0
    lvl = array.get(swingLowPrices, 0)
    bar = array.get(swingLowBars,   0)
    ln  = line.new(bar, lvl, bar_index, lvl, color = colSSL, width = 1)
    lb  = showLiqLbl ? label.new(bar_index, lvl, "SSL", color = color(na), textcolor = colSSL, style = label.style_label_left, size = size.tiny) : na
    array.push(liqs, liq.new(lvl, -1, ln, lb))
    trimLiq()

if array.size(liqs) > 0
    for i = array.size(liqs) - 1 to 0
        l = array.get(liqs, i)
        if not l.taken
            line.set_x2(l.ln, bar_index)
            if not na(l.lb)
                label.set_x(l.lb, bar_index)
            bool taken = l.bias == 1 ? high > l.level : low < l.level
            if taken
                l.taken := true
                bool sweep = l.bias == 1 ? close < l.level : close > l.level
                if sweep
                    drawSweep(l.bias, l.bias == 1 ? high : low)
                if hideTaken
                    line.delete(l.ln)
                    label.delete(l.lb)
                    array.remove(liqs, i)
                else
                    line.set_color(l.ln, colTaken)
                    line.set_style(l.ln, line.style_dotted)
                    line.set_x2(l.ln, bar_index)
                    if not na(l.lb)
                        label.set_textcolor(l.lb, colTaken)
                        label.set_x(l.lb, bar_index)

// ══════════════════════════════════════════════════════════════════
//  PART 5.2 — Equal Highs / Lows (EQH / EQL)
// ══════════════════════════════════════════════════════════════════

showEQ   = input.bool(true,  "Show equal highs/lows (EQH/EQL)", group = "Equal H/L")
eqThresh = input.float(0.1,  "Equal threshold (× ATR)", minval = 0, maxval = 0.5, step = 0.05, group = "Equal H/L")
eqPivLen = input.int(3,      "EQ pivot length (bars each side)", minval = 1, group = "Equal H/L")
atrLen   = input.int(200,    "ATR length", minval = 1, group = "Equal H/L")
colEQH   = input.color(color.new(color.teal,   0), "EQH", group = "Equal H/L")
colEQL   = input.color(color.new(color.maroon, 0), "EQL", group = "Equal H/L")
maxEQ    = input.int(8, "Max EQH/EQL lines", minval = 1, group = "Equal H/L")

atr = ta.atr(atrLen)

type eql
    float level
    int   bias
    line  ln
    label lb
    bool  taken = false

var eql[] eqs = array.new<eql>()

trimEQ() =>
    while array.size(eqs) > maxEQ
        old = array.shift(eqs)
        line.delete(old.ln)
        label.delete(old.lb)

eqPH = ta.pivothigh(high, eqPivLen, eqPivLen)
eqPL = ta.pivotlow(low,   eqPivLen, eqPivLen)

var float lastEqHigh    = na
var int   lastEqHighBar = na
var float lastEqLow     = na
var int   lastEqLowBar  = na

if showEQ and not na(eqPH)
    pBar = bar_index - eqPivLen
    if not na(lastEqHigh) and math.abs(eqPH - lastEqHigh) < eqThresh * atr
        lvl = math.max(eqPH, lastEqHigh)
        mid = math.round(0.5 * (lastEqHighBar + pBar))
        ln  = line.new(lastEqHighBar, lvl, bar_index, lvl, color = colEQH, width = 1, style = line.style_dotted)
        lb  = label.new(mid, lvl, "EQH", color = color(na), textcolor = colEQH, style = label.style_label_down, size = size.tiny)
        array.push(eqs, eql.new(lvl, 1, ln, lb))
        trimEQ()
    lastEqHigh    := eqPH
    lastEqHighBar := pBar

if showEQ and not na(eqPL)
    pBar = bar_index - eqPivLen
    if not na(lastEqLow) and math.abs(eqPL - lastEqLow) < eqThresh * atr
        lvl = math.min(eqPL, lastEqLow)
        mid = math.round(0.5 * (lastEqLowBar + pBar))
        ln  = line.new(lastEqLowBar, lvl, bar_index, lvl, color = colEQL, width = 1, style = line.style_dotted)
        lb  = label.new(mid, lvl, "EQL", color = color(na), textcolor = colEQL, style = label.style_label_up, size = size.tiny)
        array.push(eqs, eql.new(lvl, -1, ln, lb))
        trimEQ()
    lastEqLow    := eqPL
    lastEqLowBar := pBar

if array.size(eqs) > 0
    for i = array.size(eqs) - 1 to 0
        e = array.get(eqs, i)
        if not e.taken
            line.set_x2(e.ln, bar_index)
            bool taken = e.bias == 1 ? high > e.level : low < e.level
            if taken
                e.taken := true
                bool sweep = e.bias == 1 ? close < e.level : close > e.level
                if sweep
                    drawSweep(e.bias, e.bias == 1 ? high : low)
                if hideTaken
                    line.delete(e.ln)
                    label.delete(e.lb)
                    array.remove(eqs, i)
                else
                    line.set_color(e.ln, colTaken)
                    label.set_textcolor(e.lb, colTaken)
                    line.set_x2(e.ln, bar_index)

// ══════════════════════════════════════════════════════════════════
//  PART 5.4 — Session / Period Levels (PDH/PDL, PWH/PWL, Session, OR)
// ══════════════════════════════════════════════════════════════════

grpS     = "Session Levels"
showPDHL = input.bool(true,  "Prev Day High/Low (PDH/PDL)",  group = grpS)
showPWHL = input.bool(true,  "Prev Week High/Low (PWH/PWL)", group = grpS)
showSess = input.bool(true,  "Today's session High/Low",     group = grpS)
showOR   = input.bool(true,  "Opening range",                group = grpS)
orMins   = input.int(15,     "Opening range (minutes)", minval = 1, group = grpS)
sessIn   = input.session("0915-1530", "Session window (intraday)", group = grpS)
sessTz   = input.string("Asia/Kolkata", "Session timezone", group = grpS)
colPD    = input.color(color.new(color.blue,   0), "PDH/PDL",       group = grpS)
colPW    = input.color(color.new(color.purple, 0), "PWH/PWL",       group = grpS)
colSe    = input.color(color.new(color.gray,   0), "Session H/L",   group = grpS)
colORc   = input.color(color.new(color.orange, 0), "Opening range", group = grpS)

[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

isNewDay  = timeframe.change("D")
isNewWeek = timeframe.change("W")
inSess    = timeframe.isintraday and not na(time(timeframe.period, sessIn, sessTz))
newSess   = inSess and not inSess[1]

type plvl
    line  ln
    label lb
    float level
    int   bias
    bool  taken = false

mkLevel(plvl prev, float lvl, int bias, color col, string tag, int startBar) =>
    if not na(prev)
        line.delete(prev.ln)
        label.delete(prev.lb)
    line  ln = line.new(startBar, lvl, bar_index, lvl, color = col, width = 1)
    label lb = label.new(bar_index, lvl, tag, color = color(na), textcolor = col, style = label.style_label_left, size = size.tiny)
    plvl.new(ln, lb, lvl, bias)

updLevel(plvl p, color takenCol) =>
    if not na(p) and not p.taken
        line.set_x2(p.ln, bar_index)
        label.set_x(p.lb, bar_index)
        bool tk = p.bias == 1 ? high > p.level : low < p.level
        if tk
            p.taken := true
            bool sweep = p.bias == 1 ? close < p.level : close > p.level
            if sweep
                drawSweep(p.bias, p.bias == 1 ? high : low)
            line.set_color(p.ln, takenCol)
            line.set_style(p.ln, line.style_dotted)
            label.set_textcolor(p.lb, takenCol)

var plvl pdHi = na
var plvl pdLo = na
var plvl pwHi = na
var plvl pwLo = na
var plvl orHi = na
var plvl orLo = na

if showPDHL and isNewDay and not na(pdh)
    pdHi := mkLevel(pdHi, pdh,  1, colPD, "PDH", bar_index)
    pdLo := mkLevel(pdLo, pdl, -1, colPD, "PDL", bar_index)
updLevel(pdHi, colTaken)
updLevel(pdLo, colTaken)

if showPWHL and isNewWeek and not na(pwh)
    pwHi := mkLevel(pwHi, pwh,  1, colPW, "PWH", bar_index)
    pwLo := mkLevel(pwLo, pwl, -1, colPW, "PWL", bar_index)
updLevel(pwHi, colTaken)
updLevel(pwLo, colTaken)

var float orH       = na
var float orL       = na
var int   orStartBr = na
var int   sessStMs  = na
var bool  orDone    = false

if newSess
    orH       := high
    orL       := low
    orStartBr := bar_index
    sessStMs  := time
    orDone    := false
else if inSess and not orDone and not na(orH) and (time - sessStMs) < orMins * 60000
    orH := math.max(orH, high)
    orL := math.min(orL, low)

if showOR and inSess and not orDone and not na(orH) and (time - sessStMs) >= orMins * 60000
    orDone := true
    orHi   := mkLevel(orHi, orH,  1, colORc, "ORH", orStartBr)
    orLo   := mkLevel(orLo, orL, -1, colORc, "ORL", orStartBr)
updLevel(orHi, colTaken)
updLevel(orLo, colTaken)

var line  seHiLn = na
var line  seLoLn = na
var label seHiLb = na
var label seLoLb = na
var float seHi   = na
var float seLo   = na

if newSess and showSess
    line.delete(seHiLn)
    line.delete(seLoLn)
    label.delete(seHiLb)
    label.delete(seLoLb)
    seHi   := high
    seLo   := low
    seHiLn := line.new(bar_index, seHi, bar_index, seHi, color = colSe, width = 1, style = line.style_dashed)
    seLoLn := line.new(bar_index, seLo, bar_index, seLo, color = colSe, width = 1, style = line.style_dashed)
    seHiLb := label.new(bar_index, seHi, "H", color = color(na), textcolor = colSe, style = label.style_label_left, size = size.tiny)
    seLoLb := label.new(bar_index, seLo, "L", color = color(na), textcolor = colSe, style = label.style_label_left, size = size.tiny)
else if inSess and showSess and not na(seHi)
    seHi := math.max(seHi, high)
    seLo := math.min(seLo, low)
    line.set_xy2(seHiLn, bar_index, seHi)
    line.set_y1(seHiLn, seHi)
    line.set_xy2(seLoLn, bar_index, seLo)
    line.set_y1(seLoLn, seLo)
    label.set_xy(seHiLb, bar_index, seHi)
    label.set_xy(seLoLb, bar_index, seLo)

// ══════════════════════════════════════════════════════════════════
//  Strong / Weak High & Low (LuxAlgo trailing extremes)
//  Reset to the latest confirmed swing, then ratchet outward each bar.
// ══════════════════════════════════════════════════════════════════
grpSW    = "Strong / Weak High-Low"
showSWHL = input.bool(true, "Show strong / weak high & low", group = grpSW)

var float trTop    = na
var int   trTopBar = na
var float trBot    = na
var int   trBotBar = na
if swingHighJustConfirmed and array.size(swingHighPrices) > 0
    trTop    := array.get(swingHighPrices, 0)
    trTopBar := array.get(swingHighBars,   0)
if swingLowJustConfirmed and array.size(swingLowPrices) > 0
    trBot    := array.get(swingLowPrices, 0)
    trBotBar := array.get(swingLowBars,   0)
if na(trTop) or high > trTop
    trTop    := high
    trTopBar := bar_index
if na(trBot) or low < trBot
    trBot    := low
    trBotBar := bar_index

var line  swTopLine = na
var label swTopLbl  = na
var line  swBotLine = na
var label swBotLbl  = na
if showSWHL and barstate.islast and not na(trTop) and not na(trBot)
    line.delete(swTopLine)
    label.delete(swTopLbl)
    line.delete(swBotLine)
    label.delete(swBotLbl)
    int rightBarSW = bar_index + 10
    swTopLine := line.new(trTopBar, trTop, rightBarSW, trTop, color = colDown)
    swTopLbl  := label.new(rightBarSW, trTop, trend == "down" ? "Strong High" : "Weak High", color = color.new(color.white, 100), textcolor = colDown, style = label.style_label_down, size = size.tiny)
    swBotLine := line.new(trBotBar, trBot, rightBarSW, trBot, color = colUp)
    swBotLbl  := label.new(rightBarSW, trBot, trend == "up" ? "Strong Low" : "Weak Low", color = color.new(color.white, 100), textcolor = colUp, style = label.style_label_up, size = size.tiny)

// ══════════════════════════════════════════════════════════════════
//  Highs & Lows MTF (LuxAlgo) — previous Day / Week / Month H & L
// ══════════════════════════════════════════════════════════════════
grpMTF   = "Highs & Lows MTF"
showMtfD = input.bool(false, "Daily",   group = grpMTF, inline = "d")
showMtfW = input.bool(false, "Weekly",  group = grpMTF, inline = "w")
showMtfM = input.bool(false, "Monthly", group = grpMTF, inline = "m")
colMTF   = input.color(color.new(#2157f3, 0), "Levels color", group = grpMTF)

[mtfDH, mtfDL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[mtfWH, mtfWL] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[mtfMH, mtfML] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)

drawMTF(bool show, float hi, float lo, color c, string tag) =>
    var line  hLine = na
    var line  lLine = na
    var label hLbl  = na
    var label lLbl  = na
    if show and barstate.islast
        line.delete(hLine)
        line.delete(lLine)
        label.delete(hLbl)
        label.delete(lLbl)
        int L = bar_index - 60
        int R = bar_index + 20
        hLine := line.new(L, hi, R, hi, color = c)
        lLine := line.new(L, lo, R, lo, color = c)
        hLbl  := label.new(R, hi, "P" + tag + "H", color = color.new(color.white, 100), textcolor = c, style = label.style_label_left, size = size.small)
        lLbl  := label.new(R, lo, "P" + tag + "L", color = color.new(color.white, 100), textcolor = c, style = label.style_label_left, size = size.small)

drawMTF(showMtfD, mtfDH, mtfDL, colMTF, "D")
drawMTF(showMtfW, mtfWH, mtfWL, colMTF, "W")
drawMTF(showMtfM, mtfMH, mtfML, colMTF, "M")

// ══════════════════════════════════════════════════════════════════
//  PART 6 — Premium / Discount Zones   (LuxAlgo — anchored to trailing extremes)
// ══════════════════════════════════════════════════════════════════

grpPD    = "Premium / Discount"
showPD   = input.bool(false, "Show premium/discount zones",                group = grpPD)
pdStyle  = input.string("Thin bands (Lux)", "Zone style", options = ["Full halves", "Thin bands (Lux)"], group = grpPD)
showEqL  = input.bool(false, "Show equilibrium (line / band)",             group = grpPD)
showOTE  = input.bool(false, "Show OTE zones (0.62–0.79)",                 group = grpPD)
hlActive = input.bool(false, "Highlight only actionable half (per trend)", group = grpPD)
colPrem  = input.color(color.new(color.red,   85), "Premium fill",   group = grpPD)
colDisc  = input.color(color.new(color.green, 85), "Discount fill",  group = grpPD)
colEqL   = input.color(color.new(color.gray,   0), "Equilibrium",    group = grpPD)
colOTEc  = input.color(color.new(color.orange,75), "OTE fill",       group = grpPD)
dimTrans = input.int(96, "Dimmed-half transparency", minval = 0, maxval = 100, group = grpPD)

var float rngHigh    = na
var int   rngHighBar = na
var float rngLow     = na
var int   rngLowBar  = na

if not na(trTop) and not na(trBot)
    rngHigh    := trTop
    rngHighBar := trTopBar
    rngLow     := trBot
    rngLowBar  := trBotBar

var box  premBox = na
var box  discBox = na
var line eqLine  = na
var box  eqBox   = na
var box  oteLoB  = na
var box  oteHiB  = na

if not na(rngHigh) and not na(rngLow) and rngHigh > rngLow
    float eq      = math.avg(rngHigh, rngLow)
    float rng     = rngHigh - rngLow
    int   leftBar = math.min(rngHighBar, rngLowBar)
    bool  dimPrem = hlActive and trend == "up"
    bool  dimDisc = hlActive and trend == "down"
    color premCol = dimPrem ? color.new(colPrem, dimTrans) : colPrem
    color discCol = dimDisc ? color.new(colDisc, dimTrans) : colDisc
    bool  thin    = pdStyle == "Thin bands (Lux)"
    float premTop = rngHigh
    float premBot = thin ? 0.95 * rngHigh + 0.05 * rngLow : eq
    float discTop = thin ? 0.95 * rngLow  + 0.05 * rngHigh : eq
    float discBot = rngLow

    if showPD
        if na(premBox)
            premBox := box.new(leftBar, premTop, bar_index, premBot, border_color = na, bgcolor = premCol)
            discBox := box.new(leftBar, discTop, bar_index, discBot, border_color = na, bgcolor = discCol)
        else
            box.set_lefttop(premBox, leftBar, premTop)
            box.set_rightbottom(premBox, bar_index, premBot)
            box.set_bgcolor(premBox, premCol)
            box.set_lefttop(discBox, leftBar, discTop)
            box.set_rightbottom(discBox, bar_index, discBot)
            box.set_bgcolor(discBox, discCol)

    if showEqL
        if thin
            float eqT = 0.525 * rngHigh + 0.475 * rngLow
            float eqB = 0.525 * rngLow  + 0.475 * rngHigh
            if na(eqBox)
                eqBox := box.new(leftBar, eqT, bar_index, eqB, border_color = na, bgcolor = color.new(colEqL, 80))
            else
                box.set_lefttop(eqBox, leftBar, eqT)
                box.set_rightbottom(eqBox, bar_index, eqB)
        else
            if na(eqLine)
                eqLine := line.new(leftBar, eq, bar_index, eq, color = colEqL, style = line.style_dashed, width = 1)
            else
                line.set_xy1(eqLine, leftBar, eq)
                line.set_xy2(eqLine, bar_index, eq)

    if showOTE
        float loteB = rngLow + 0.21 * rng
        float loteT = rngLow + 0.38 * rng
        float poteB = rngLow + 0.62 * rng
        float poteT = rngLow + 0.79 * rng
        if na(oteLoB)
            oteLoB := box.new(leftBar, loteT, bar_index, loteB, border_color = na, bgcolor = colOTEc)
            oteHiB := box.new(leftBar, poteT, bar_index, poteB, border_color = na, bgcolor = colOTEc)
        else
            box.set_lefttop(oteLoB, leftBar, loteT)
            box.set_rightbottom(oteLoB, bar_index, loteB)
            box.set_lefttop(oteHiB, leftBar, poteT)
            box.set_rightbottom(oteHiB, bar_index, poteB)

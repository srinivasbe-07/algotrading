//@version=6
indicator('SMC - Phase 3: Order Blocks', overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 200)

// ─────────────────────────────────────────────
// CONSTANTS
// ─────────────────────────────────────────────
BULLISH_LEG = 1
BEARISH_LEG = 0

BULLISH = +1
BEARISH = -1

GREEN = #089981
RED   = #F23645

ALL   = 'All'
BOS   = 'BOS'
CHOCH = 'CHoCH'

CLOSE = 'Close'
WICKS = 'Wicks'

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
swingsLengthInput   = input.int(   50,    'Swing Length',    minval = 10,                 group = 'Swing Detection')
showSwingsInput     = input(       true,  'Show Swing Points',                            group = 'Swing Detection')

showStructureInput  = input(       true,  'Show Structure',                               group = 'Structure')
showSwingBullInput  = input.string(ALL,   'Bullish',         options = [ALL, BOS, CHOCH], group = 'Structure', inline = 'bull')
swingBullColorInput = input.color( GREEN, '',                                             group = 'Structure', inline = 'bull')
showSwingBearInput  = input.string(ALL,   'Bearish',         options = [ALL, BOS, CHOCH], group = 'Structure', inline = 'bear')
swingBearColorInput = input.color( RED,   '',                                             group = 'Structure', inline = 'bear')
showBgColorInput    = input(       true,  'Background Color',                             group = 'Structure')

showOBInput         = input(       true,  'Show Order Blocks',                            group = 'Order Blocks')
obCountInput        = input.int(   5,     'Max OBs',         minval = 1, maxval = 20,     group = 'Order Blocks')
obMitigationInput   = input.string(CLOSE, 'Mitigation',      options = [CLOSE, WICKS],    group = 'Order Blocks')
showMitigatedOBInput= input(       true,  'Show Mitigated',                               group = 'Order Blocks')
obBullColorInput    = input.color( color.new(GREEN, 80), 'Bullish OB',                    group = 'Order Blocks')
obBearColorInput    = input.color( color.new(RED,   80), 'Bearish OB',                    group = 'Order Blocks')

// ─────────────────────────────────────────────
// DATA STRUCTURES
// ─────────────────────────────────────────────
type pivot
    float currentLevel = na
    float lastLevel    = na
    int   barTime      = na
    int   barIndex     = na
    bool  crossed      = false

type trend
    int bias = 0

// stores one active order block + its drawn box
type orderBlock
    float barHigh
    float barLow
    int   barTime
    int   bias
    box   boxRef
    bool  mitigated = false

var pivot swingHigh  = pivot.new()
var pivot swingLow   = pivot.new()
var trend swingTrend = trend.new(0)

var array<orderBlock> orderBlocks = array.new<orderBlock>()

// every bar's OHLC stored so storeOrderBlock can look back into any range
var array<float> barOpens  = array.new<float>()
var array<float> barHighs  = array.new<float>()
var array<float> barLows   = array.new<float>()
var array<float> barCloses = array.new<float>()
var array<int>   barTimes  = array.new<int>()

// ─────────────────────────────────────────────
// PHASE 1 — Swing Detection
// ─────────────────────────────────────────────
leg(int size) =>
    var int currentLeg = BEARISH_LEG
    highestHigh        = ta.highest(size)
    lowestLow          = ta.lowest(size)
    if high[size] > highestHigh
        currentLeg := BEARISH_LEG
    else if low[size] < lowestLow
        currentLeg := BULLISH_LEG
    currentLeg

startOfNewLeg(int currentLeg)     => ta.change(currentLeg) != 0
startOfBullishLeg(int currentLeg) => ta.change(currentLeg) == +1
startOfBearishLeg(int currentLeg) => ta.change(currentLeg) == -1

drawLabel(int labelTime, float labelPrice, string tag, color labelColor, string labelStyle) =>
    label.new(
     x         = labelTime,
     y         = labelPrice,
     text      = tag,
     xloc      = xloc.bar_time,
     color     = color(na),
     textcolor = labelColor,
     style     = labelStyle,
     size      = size.small)

getCurrentStructure(int size) =>
    int  currentLeg = leg(size)
    bool newPivot   = startOfNewLeg(currentLeg)
    bool pivotLow   = startOfBullishLeg(currentLeg)
    bool pivotHigh  = startOfBearishLeg(currentLeg)

    if newPivot
        if pivotLow
            string tag = low[size] > swingLow.currentLevel ? 'HL' : 'LL'
            swingLow.lastLevel    := swingLow.currentLevel
            swingLow.currentLevel := low[size]
            swingLow.crossed      := false
            swingLow.barTime      := time[size]
            swingLow.barIndex     := bar_index[size]
            if showSwingsInput
                drawLabel(time[size], low[size], tag, GREEN, label.style_label_up)
        else if pivotHigh
            string tag = high[size] > swingHigh.currentLevel ? 'HH' : 'LH'
            swingHigh.lastLevel    := swingHigh.currentLevel
            swingHigh.currentLevel := high[size]
            swingHigh.crossed      := false
            swingHigh.barTime      := time[size]
            swingHigh.barIndex     := bar_index[size]
            if showSwingsInput
                drawLabel(time[size], high[size], tag, RED, label.style_label_down)

// ─────────────────────────────────────────────
// PHASE 2 — Market Structure (BOS & CHoCH)
// ─────────────────────────────────────────────
drawStructure(pivot p_ivot, string tag, color structureColor, string labelStyle) =>
    line.new(
     chart.point.new(p_ivot.barTime, na, p_ivot.currentLevel),
     chart.point.new(time, na, p_ivot.currentLevel),
     xloc.bar_time,
     color = structureColor,
     style = line.style_solid)
    label.new(
     chart.point.new(na, math.round(0.5 * (p_ivot.barIndex + bar_index)), p_ivot.currentLevel),
     tag,
     xloc.bar_index,
     color     = color(na),
     textcolor = structureColor,
     style     = labelStyle,
     size      = size.small)

// ─────────────────────────────────────────────
// PHASE 3 — Order Blocks
// ─────────────────────────────────────────────

// At BOS/CHoCH moment:
//   Bullish OB = last RED candle (close < open) before bullish BOS — where sellers gave up
//   Bearish OB = last GREEN candle (close > open) before bearish BOS — where buyers gave up
//   Valid OB must leave an imbalance/FVG after it (OB-5, OB-6, OB-7 criteria)
storeOrderBlock(pivot p_ivot, int bias) =>
    if showOBInput and not na(p_ivot.barIndex)
        int startIdx = p_ivot.barIndex
        int endIdx   = bar_index        // BOS bar — not included in search

        if endIdx > startIdx
            float obHigh = na
            float obLow  = na
            int   obTime = na
            int   obIdx  = na

            if bias == BULLISH
                // scan backwards — find last RED candle (close < open)
                for i = endIdx - 1 to startIdx
                    if barCloses.get(i) < barOpens.get(i)
                        obIdx  := i
                        obHigh := barHighs.get(i)
                        obLow  := barLows.get(i)
                        obTime := barTimes.get(i)
                        break
                // fallback: no red candle found → use lowest low
                if na(obIdx)
                    float minLow = na
                    for i = startIdx to endIdx - 1
                        l = barLows.get(i)
                        if na(minLow) or l < minLow
                            minLow := l
                            obIdx  := i
                            obHigh := barHighs.get(i)
                            obLow  := l
                            obTime := barTimes.get(i)
            else
                // scan backwards — find last GREEN candle (close > open)
                for i = endIdx - 1 to startIdx
                    if barCloses.get(i) > barOpens.get(i)
                        obIdx  := i
                        obHigh := barHighs.get(i)
                        obLow  := barLows.get(i)
                        obTime := barTimes.get(i)
                        break
                // fallback: no green candle found → use highest high
                if na(obIdx)
                    float maxHigh = na
                    for i = startIdx to endIdx - 1
                        h = barHighs.get(i)
                        if na(maxHigh) or h > maxHigh
                            maxHigh := h
                            obIdx   := i
                            obHigh  := h
                            obLow   := barLows.get(i)
                            obTime  := barTimes.get(i)

            if not na(obTime)
                obColor = bias == BULLISH ? obBullColorInput : obBearColorInput
                b = box.new(
                     left         = obTime,
                     top          = obHigh,
                     right        = time,
                     bottom       = obLow,
                     xloc         = xloc.bar_time,
                     extend       = extend.right,
                     bgcolor      = obColor,
                     border_color = obColor)

                ob = orderBlock.new(obHigh, obLow, obTime, bias, b)

                // count only active (unmitigated) OBs against the limit
                activeCount = 0
                for each in orderBlocks
                    if not each.mitigated
                        activeCount += 1

                if activeCount >= obCountInput
                    // remove oldest active OB to make room
                    for j = orderBlocks.size() - 1 to 0
                        if not orderBlocks.get(j).mitigated
                            orderBlocks.get(j).boxRef.delete()
                            orderBlocks.remove(j)
                            break

                // cap total array (active + mitigated) to prevent bloat
                if orderBlocks.size() >= obCountInput * 2
                    oldest = orderBlocks.pop()
                    oldest.boxRef.delete()

                orderBlocks.unshift(ob)

// Each bar: check every active OB for mitigation
// When hit → fade box and stop extending (instead of deleting)
deleteOrderBlocks() =>
    int i = orderBlocks.size() - 1
    while i >= 0
        ob = orderBlocks.get(i)

        if not ob.mitigated
            bool hit = false
            if ob.bias == BULLISH
                mitigSrc = obMitigationInput == CLOSE ? close : low
                hit      := mitigSrc < ob.barLow
            else
                mitigSrc = obMitigationInput == CLOSE ? close : high
                hit      := mitigSrc > ob.barHigh

            if hit
                ob.mitigated := true
                if showMitigatedOBInput
                    // stop extending, shrink to mitigated bar
                    // no fill + solid border = clearly different from active (filled) OB
                    ob.boxRef.set_extend(extend.none)
                    ob.boxRef.set_right(time)
                    ob.boxRef.set_bgcolor(color(na))
                    ob.boxRef.set_border_color(ob.bias == BULLISH ? GREEN : RED)
                    ob.boxRef.set_border_width(2)
                else
                    ob.boxRef.delete()
                    orderBlocks.remove(i)

        i -= 1

// BOS & CHoCH detection — triggers OB storage
displayStructure() =>
    if ta.crossover(close, swingHigh.currentLevel) and not swingHigh.crossed
        string tag        = swingTrend.bias == BEARISH ? CHOCH : BOS
        swingHigh.crossed := true
        swingTrend.bias   := BULLISH
        if showStructureInput and (showSwingBullInput == ALL or showSwingBullInput == tag)
            drawStructure(swingHigh, tag, swingBullColorInput, label.style_label_down)
        storeOrderBlock(swingHigh, BULLISH)

    if ta.crossunder(close, swingLow.currentLevel) and not swingLow.crossed
        string tag       = swingTrend.bias == BULLISH ? CHOCH : BOS
        swingLow.crossed := true
        swingTrend.bias  := BEARISH
        if showStructureInput and (showSwingBearInput == ALL or showSwingBearInput == tag)
            drawStructure(swingLow, tag, swingBearColorInput, label.style_label_up)
        storeOrderBlock(swingLow, BEARISH)

// ─────────────────────────────────────────────
// EXECUTION
// ─────────────────────────────────────────────

// push current bar data FIRST so storeOrderBlock can read it during BOS detection
barOpens.push(open)
barHighs.push(high)
barLows.push(low)
barCloses.push(close)
barTimes.push(time)

getCurrentStructure(swingsLengthInput)
displayStructure()
deleteOrderBlocks()

bgcolor(showBgColorInput ? (swingTrend.bias == BULLISH ? color.new(GREEN, 92) : color.new(RED, 92)) : na)

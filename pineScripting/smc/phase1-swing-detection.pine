//@version=6
indicator('SMC - Phase 1: Swing Detection', overlay = true, max_labels_count = 500)

// ─────────────────────────────────────────────
// CONSTANTS
// ─────────────────────────────────────────────

BULLISH_LEG = 1
BEARISH_LEG = 0

GREEN = #089981
RED   = #F23645

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
swingsLengthInput = input.int(50, 'Swing Length', minval = 10)

// ─────────────────────────────────────────────
// DATA STRUCTURES
// ─────────────────────────────────────────────

// Stores the last detected pivot point
// currentLevel : price of the most recent pivot
// lastLevel    : price of the pivot before that (used to compare HH/HL/LH/LL)
// barTime      : time of the pivot bar (used to place label at correct x position)
type pivot
    float currentLevel = na
    float lastLevel    = na
    int   barTime      = na

// One pivot tracker for highs, one for lows
var pivot swingHigh = pivot.new()
var pivot swingLow  = pivot.new()

// ─────────────────────────────────────────────
// STEP 1 — leg()
// Detects current leg direction (bullish or bearish)
//
// Logic:
//   Look back 'size' bars.
//   If high[size] was the highest point of the last 'size' bars
//     → price peaked 'size' bars ago → bearish leg now
//   If low[size] was the lowest point of the last 'size' bars
//     → price bottomed 'size' bars ago → bullish leg now
// ─────────────────────────────────────────────
leg(int size) =>
    var int currentLeg = BEARISH_LEG
    highestHigh = ta.highest(size)
    lowestLow   = ta.lowest(size)
    if high[size] > highestHigh
        currentLeg := BEARISH_LEG
    else if low[size] < lowestLow
        currentLeg := BULLISH_LEG
    currentLeg

// ─────────────────────────────────────────────
// STEP 2 — startOfNewLeg / startOfBullishLeg / startOfBearishLeg
// Detects when the leg direction changed → pivot just formed
//
// startOfNewLeg     : leg changed in either direction  → some pivot formed
// startOfBullishLeg : leg changed from bearish→bullish → LOW pivot formed
// startOfBearishLeg : leg changed from bullish→bearish → HIGH pivot formed
// ─────────────────────────────────────────────
startOfNewLeg(int currentLeg)     => ta.change(currentLeg) != 0
startOfBullishLeg(int currentLeg) => ta.change(currentLeg) == +1
startOfBearishLeg(int currentLeg) => ta.change(currentLeg) == -1

// ─────────────────────────────────────────────
// STEP 3 — getCurrentStructure()
// Ties everything together:
//   1. Get current leg
//   2. Check if leg changed → pivot formed
//   3. Compare new pivot to last pivot → label HH / HL / LH / LL
//   4. Draw label on chart at the pivot bar
// ─────────────────────────────────────────────
getCurrentStructure(int size) =>
    int currentLeg  = leg(size)
    bool newPivot   = startOfNewLeg(currentLeg)
    bool pivotLow   = startOfBullishLeg(currentLeg)  // leg → bullish = LOW just formed
    bool pivotHigh  = startOfBearishLeg(currentLeg)  // leg → bearish = HIGH just formed

    if newPivot
        if pivotLow
            // A swing LOW formed 'size' bars ago
            // Compare new low to last low → HL or LL
            string tag = low[size] > swingLow.currentLevel ? 'HL' : 'LL'

            // Update pivot tracker
            swingLow.lastLevel    := swingLow.currentLevel
            swingLow.currentLevel := low[size]
            swingLow.barTime      := time[size]

            // Draw label below the pivot bar
            label.new(
             x         = swingLow.barTime,
             y         = swingLow.currentLevel,
             text      = tag,
             xloc      = xloc.bar_time,
             color     = color(na),
             textcolor = GREEN,
             style     = label.style_label_up,
             size      = size.small)

        else if pivotHigh
            // A swing HIGH formed 'size' bars ago
            // Compare new high to last high → HH or LH
            string tag = high[size] > swingHigh.currentLevel ? 'HH' : 'LH'

            // Update pivot tracker
            swingHigh.lastLevel    := swingHigh.currentLevel
            swingHigh.currentLevel := high[size]
            swingHigh.barTime      := time[size]

            // Draw label above the pivot bar
            label.new(
             x         = swingHigh.barTime,
             y         = swingHigh.currentLevel,
             text      = tag,
             xloc      = xloc.bar_time,
             color     = color(na),
             textcolor = RED,
             style     = label.style_label_down,
             size      = size.small)

// ─────────────────────────────────────────────
// EXECUTION
// ─────────────────────────────────────────────
getCurrentStructure(swingsLengthInput)

//@version=6
indicator("SMC - Market Structure Phase 4 (Entries & Exits)", overlay=true,
          max_lines_count=500, max_labels_count=500)

// ─── INPUTS ────────────────────────────────────────────────────────────────
// External structure uses larger pivot lookback (10 bars each side) to capture
// major swing highs/lows that represent the big picture trend.
extLeft  = input.int(10, "External Left Bars",  minval=1, group="External Structure")
extRight = input.int(10, "External Right Bars", minval=1, group="External Structure")
// Internal structure uses smaller lookback (3 bars each side) to capture
// minor swings and short-term moves within the bigger trend.
intLeft  = input.int(3,  "Internal Left Bars",  minval=1, group="Internal Structure")
intRight = input.int(3,  "Internal Right Bars", minval=1, group="Internal Structure")

showExternal  = input.bool(true, "Show External Structure",     group="External Structure")
showInternal  = input.bool(true, "Show Internal Structure",     group="Internal Structure")
showChochLine = input.bool(true, "Show CHoCH Protection Level", group="Display")
showBias      = input.bool(true, "Show Bias Background",        group="Display")

// ─── SWING DETECTION ───────────────────────────────────────────────────────
// ta.pivothigh returns the high value when a swing high is confirmed.
// Pivot is confirmed extRight bars LATE — actual bar was at bar_index - extRight.
extSwingHigh = ta.pivothigh(high, extLeft, extRight)
extSwingLow  = ta.pivotlow(low,   extLeft, extRight)
intSwingHigh = ta.pivothigh(high, intLeft, intRight)
intSwingLow  = ta.pivotlow(low,   intLeft, intRight)

// ─── EXTERNAL STRUCTURE LINES + LABELS ────────────────────────────────────
// var variables persist across all bars to store the previous swing
// so we can compare each new swing against it (HH/HL/LH/LL detection).
var float extLastHigh    = na  // price of the previous external swing high
var int   extLastHighBar = na  // bar index of the previous external swing high
var float extLastLow     = na  // price of the previous external swing low
var int   extLastLowBar  = na  // bar index of the previous external swing low

if not na(extSwingHigh)
    pivotBar   = bar_index - extRight  // actual bar where pivot occurred
    pivotPrice = extSwingHigh
    if showExternal
        if not na(extLastHigh)
            // HH (Higher High) = bullish structure → blue
            // LH (Lower High)  = bearish structure → red
            isHH = pivotPrice > extLastHigh
            line.new(x1=extLastHighBar, y1=extLastHigh, x2=pivotBar, y2=pivotPrice,
                     color=isHH ? color.blue : color.red, width=2, style=line.style_solid)
            label.new(x=pivotBar, y=pivotPrice, text=isHH ? "HH" : "LH",
                      yloc=yloc.abovebar, style=label.style_none,
                      textcolor=isHH ? color.blue : color.red, size=size.small)
        else
            // SH = Starting High — very first swing high, no previous to compare
            label.new(x=pivotBar, y=pivotPrice, text="SH",
                      yloc=yloc.abovebar, style=label.style_none,
                      textcolor=color.gray, size=size.small)
    // Save this swing as the new "previous" for next comparison
    extLastHigh    := pivotPrice
    extLastHighBar := pivotBar

if not na(extSwingLow)
    pivotBar   = bar_index - extRight
    pivotPrice = extSwingLow
    if showExternal
        if not na(extLastLow)
            // HL (Higher Low) = bullish structure → blue
            // LL (Lower Low)  = bearish structure → red
            isHL = pivotPrice > extLastLow
            line.new(x1=extLastLowBar, y1=extLastLow, x2=pivotBar, y2=pivotPrice,
                     color=isHL ? color.blue : color.red, width=2, style=line.style_solid)
            label.new(x=pivotBar, y=pivotPrice, text=isHL ? "HL" : "LL",
                      yloc=yloc.belowbar, style=label.style_none,
                      textcolor=isHL ? color.blue : color.red, size=size.small)
        else
            // SL = Starting Low — very first swing low, no previous to compare
            label.new(x=pivotBar, y=pivotPrice, text="SL",
                      yloc=yloc.belowbar, style=label.style_none,
                      textcolor=color.gray, size=size.small)
    extLastLow    := pivotPrice
    extLastLowBar := pivotBar

// ─── INTERNAL STRUCTURE LINES + LABELS ────────────────────────────────────
// Same as external but uses smaller pivot settings (intLeft/intRight).
// Lines are dashed, thinner, and semi-transparent to visually rank below external.
// Labels are lowercase and tiny to distinguish from external uppercase labels.
var float intLastHigh    = na
var int   intLastHighBar = na
var float intLastLow     = na
var int   intLastLowBar  = na

if not na(intSwingHigh)
    pivotBar   = bar_index - intRight
    pivotPrice = intSwingHigh
    if showInternal
        if not na(intLastHigh)
            isHH = pivotPrice > intLastHigh
            line.new(x1=intLastHighBar, y1=intLastHigh, x2=pivotBar, y2=pivotPrice,
                     color=isHH ? color.new(color.blue, 50) : color.new(color.red, 50),
                     width=1, style=line.style_dashed)
            label.new(x=pivotBar, y=pivotPrice, text=isHH ? "hh" : "lh",
                      yloc=yloc.abovebar, style=label.style_none,
                      textcolor=isHH ? color.blue : color.red, size=size.tiny)
        else
            label.new(x=pivotBar, y=pivotPrice, text="sh",
                      yloc=yloc.abovebar, style=label.style_none,
                      textcolor=color.gray, size=size.tiny)
    intLastHigh    := pivotPrice
    intLastHighBar := pivotBar

if not na(intSwingLow)
    pivotBar   = bar_index - intRight
    pivotPrice = intSwingLow
    if showInternal
        if not na(intLastLow)
            isHL = pivotPrice > intLastLow
            line.new(x1=intLastLowBar, y1=intLastLow, x2=pivotBar, y2=pivotPrice,
                     color=isHL ? color.new(color.blue, 50) : color.new(color.red, 50),
                     width=1, style=line.style_dashed)
            label.new(x=pivotBar, y=pivotPrice, text=isHL ? "hl" : "ll",
                      yloc=yloc.belowbar, style=label.style_none,
                      textcolor=isHL ? color.blue : color.red, size=size.tiny)
        else
            label.new(x=pivotBar, y=pivotPrice, text="sl",
                      yloc=yloc.belowbar, style=label.style_none,
                      textcolor=color.gray, size=size.tiny)
    intLastLow    := pivotPrice
    intLastLowBar := pivotBar

// ─── EXTERNAL BOS / CHoCH ─────────────────────────────────────────────────
// BOS  (Break of Structure)   = price breaks in the SAME direction as current bias → trend continues
// CHoCH (Change of Character) = price breaks in the OPPOSITE direction → trend reversing
//
// extBias tracks current market direction based on last BOS/CHoCH:
//   0  = no bias established yet
//   1  = bullish (last break was upward)
//  -1  = bearish (last break was downward)
var int   extBias       = 0
var float extBosHigh    = na     // last swing high — watched for upward break
var int   extBosHighBar = na     // bar index of that swing high
var bool  extHighBroken = false  // prevents re-firing after same level is broken
var float extBosLow     = na     // last swing low — watched for downward break
var int   extBosLowBar  = na
var bool  extLowBroken  = false
// extRunMin = lowest low since the last swing high was detected.
// Used as the CHoCH protection level after a bullish BOS fires.
// If price later drops below this, the bullish move may be failing.
var float extRunMin     = na
// extRunMax = highest high since the last swing low was detected.
// Used as the CHoCH protection level after a bearish BOS fires.
var float extRunMax     = na
var line  extChochLine  = na     // the yellow dashed protection level line on chart

// When a new swing high is detected, store it as the BOS candidate
// and begin tracking the lowest low from this swing onward.
if not na(extSwingHigh)
    extBosHigh    := extSwingHigh
    extBosHighBar := bar_index - extRight
    extHighBroken := false                    // reset so this level can fire once
    extRunMin     := ta.lowest(low, extRight) // seed RunMin with pivot window lows

if not na(extSwingLow)
    extBosLow    := extSwingLow
    extBosLowBar := bar_index - extRight
    extLowBroken := false
    extRunMax    := ta.highest(high, extRight)

// Every bar, keep RunMin/RunMax updated so they always hold the
// true extreme since the last swing was set.
if not na(extRunMin)
    extRunMin := math.min(extRunMin, low)
if not na(extRunMax)
    extRunMax := math.max(extRunMax, high)

// ── Upward BOS or CHoCH ───────────────────────────────────────────────────
// Fires when a confirmed bar closes ABOVE the last recorded swing high.
// extHighBroken guard ensures it fires only once per swing high level.
if barstate.isconfirmed and not na(extBosHigh) and not extHighBroken and close > extBosHigh
    extHighBroken := true
    // If previous bias was bearish (-1) → this upward break = CHoCH (reversal)
    // If previous bias was bullish or 0  → this upward break = BOS (continuation)
    isCHoCH       = extBias == -1
    lineCol       = isCHoCH ? color.orange : color.green
    line.new(x1=extBosHighBar, y1=extBosHigh, x2=bar_index, y2=extBosHigh,
             color=lineCol, width=2, style=line.style_dotted)
    label.new(x=math.round((extBosHighBar + bar_index) / 2), y=extBosHigh,
              text=isCHoCH ? "CHoCH" : "BOS",
              style=label.style_label_center, color=lineCol,
              textcolor=color.white, size=size.small)
    extBias := 1  // bias is now bullish
    // Draw yellow protection line at lowest low between swing high and BOS bar.
    // Price closing below this line signals the bullish bias may be invalidated.
    if showChochLine
        if not na(extChochLine)
            line.delete(extChochLine)  // remove previous protection line
        extChochLine := line.new(x1=extBosHighBar, y1=extRunMin, x2=bar_index, y2=extRunMin,
                                  color=color.yellow, width=1, style=line.style_dashed,
                                  extend=extend.right)

// ── Downward BOS or CHoCH ─────────────────────────────────────────────────
// Fires when a confirmed bar closes BELOW the last recorded swing low.
if barstate.isconfirmed and not na(extBosLow) and not extLowBroken and close < extBosLow
    extLowBroken := true
    // If previous bias was bullish (1) → this downward break = CHoCH (reversal)
    // If previous bias was bearish or 0 → this downward break = BOS (continuation)
    isCHoCH      = extBias == 1
    lineCol      = isCHoCH ? color.orange : color.red
    line.new(x1=extBosLowBar, y1=extBosLow, x2=bar_index, y2=extBosLow,
             color=lineCol, width=2, style=line.style_dotted)
    label.new(x=math.round((extBosLowBar + bar_index) / 2), y=extBosLow,
              text=isCHoCH ? "CHoCH" : "BOS",
              style=label.style_label_center, color=lineCol,
              textcolor=color.white, size=size.small)
    extBias := -1  // bias is now bearish
    // Protection line at highest high between swing low and BOS bar.
    // Price closing above this signals bearish bias may be invalidated.
    if showChochLine
        if not na(extChochLine)
            line.delete(extChochLine)
        extChochLine := line.new(x1=extBosLowBar, y1=extRunMax, x2=bar_index, y2=extRunMax,
                                  color=color.yellow, width=1, style=line.style_dashed,
                                  extend=extend.right)

// ─── INTERNAL BOS / CHoCH ─────────────────────────────────────────────────
// Same BOS/CHoCH logic as external but applied to smaller internal swings.
// Internal breaks happen more frequently and signal short-term momentum shifts.
// No CHoCH protection line for internal — only external gets that.
var int   intBias       = 0
var float intBosHigh    = na
var int   intBosHighBar = na
var bool  intHighBroken = false
var float intBosLow     = na
var int   intBosLowBar  = na
var bool  intLowBroken  = false
var float intRunMin     = na
var float intRunMax     = na

if not na(intSwingHigh)
    intBosHigh    := intSwingHigh
    intBosHighBar := bar_index - intRight
    intHighBroken := false
    intRunMin     := ta.lowest(low, intRight)

if not na(intSwingLow)
    intBosLow    := intSwingLow
    intBosLowBar := bar_index - intRight
    intLowBroken := false
    intRunMax    := ta.highest(high, intRight)

if not na(intRunMin)
    intRunMin := math.min(intRunMin, low)
if not na(intRunMax)
    intRunMax := math.max(intRunMax, high)

if barstate.isconfirmed and not na(intBosHigh) and not intHighBroken and close > intBosHigh
    intHighBroken := true
    isCHoCH       = intBias == -1
    lineCol       = isCHoCH ? color.orange : color.green
    line.new(x1=intBosHighBar, y1=intBosHigh, x2=bar_index, y2=intBosHigh,
             color=lineCol, width=1, style=line.style_dotted)
    label.new(x=math.round((intBosHighBar + bar_index) / 2), y=intBosHigh,
              text=isCHoCH ? "choch" : "bos",
              style=label.style_label_center, color=lineCol,
              textcolor=color.white, size=size.tiny)
    intBias := 1

if barstate.isconfirmed and not na(intBosLow) and not intLowBroken and close < intBosLow
    intLowBroken := true
    isCHoCH      = intBias == 1
    lineCol      = isCHoCH ? color.orange : color.red
    line.new(x1=intBosLowBar, y1=intBosLow, x2=bar_index, y2=intBosLow,
             color=lineCol, width=1, style=line.style_dotted)
    label.new(x=math.round((intBosLowBar + bar_index) / 2), y=intBosLow,
              text=isCHoCH ? "choch" : "bos",
              style=label.style_label_center, color=lineCol,
              textcolor=color.white, size=size.tiny)
    intBias := -1

// ─── BIAS BACKGROUND ──────────────────────────────────────────────────────
// Colors the chart background based on external bias for quick visual context.
// Green = bullish bias, Red = bearish bias, Gray = no bias established yet.
// 90% transparency keeps it subtle so candles remain clearly visible.
biasColor = extBias == 1 ? color.new(color.green, 90) : extBias == -1 ? color.new(color.red, 90) : color.new(color.gray, 95)
bgcolor(showBias ? biasColor : na, title="Bias Background")

// ─── PHASE 4: ENTRIES & EXITS ─────────────────────────────────────────────
// SMC entry logic requires BOTH biases to align before entering a trade:
//   Long entry:  extBias bullish AND intBias just flipped bullish
//   Short entry: extBias bearish AND intBias just flipped bearish
//
// The "just flipped" condition (intBias[1] != 1) ensures we only enter ONCE
// at the moment of alignment, not on every bar while both biases are aligned.
//
// Exit logic is intentionally early/defensive — exits as soon as EITHER bias
// turns against the trade, without waiting for a full reversal signal.

// tradeDir tracks the current open position to prevent duplicate entries:
//  1 = currently long, -1 = currently short, 0 = flat (no open trade)
var int tradeDir = 0

// ── Entry Conditions ──────────────────────────────────────────────────────
// Long:  not already long + extBias bullish + intBias just flipped bullish
// Short: not already short + extBias bearish + intBias just flipped bearish
longEntry  = tradeDir != 1  and extBias == 1  and intBias == 1  and intBias[1] != 1  and barstate.isconfirmed
shortEntry = tradeDir != -1 and extBias == -1 and intBias == -1 and intBias[1] != -1 and barstate.isconfirmed

// ── Exit Conditions ───────────────────────────────────────────────────────
// Long exit:  in a long AND (extBias just flipped bearish OR intBias just flipped bearish)
// Short exit: in a short AND (extBias just flipped bullish OR intBias just flipped bullish)
// The [1] check ensures we react on the exact bar the bias flips, not every bar after.
longExit   = tradeDir == 1  and ((extBias == -1 and extBias[1] != -1) or (intBias == -1 and intBias[1] != -1)) and barstate.isconfirmed
shortExit  = tradeDir == -1 and ((extBias == 1  and extBias[1] != 1)  or (intBias == 1  and intBias[1] != 1))  and barstate.isconfirmed

// Process exits before entries so a same-bar reversal exits then re-enters correctly
if longExit or shortExit
    tradeDir := 0
if longEntry
    tradeDir := 1
if shortEntry
    tradeDir := -1

// ─── SIGNALS ──────────────────────────────────────────────────────────────
// Visual arrows on chart — green arrow up for long, red arrow down for short,
// orange X cross for exits on either side.
plotshape(longEntry,  title="Long Entry",  style=shape.arrowup,   location=location.belowbar, color=color.green,  size=size.normal, text="Long")
plotshape(shortEntry, title="Short Entry", style=shape.arrowdown, location=location.abovebar, color=color.red,    size=size.normal, text="Short")
plotshape(longExit,   title="Long Exit",   style=shape.xcross,    location=location.abovebar, color=color.orange, size=size.small,  text="Exit")
plotshape(shortExit,  title="Short Exit",  style=shape.xcross,    location=location.belowbar, color=color.orange, size=size.small,  text="Exit")

// ─── ALERTS ───────────────────────────────────────────────────────────────
// TradingView alert conditions — trigger these in the Alerts panel
// to get notified when entry or exit signals fire.
alertcondition(longEntry,  "SMC Long Entry",  "SMC: BUY signal")
alertcondition(shortEntry, "SMC Short Entry", "SMC: SELL signal")
alertcondition(longExit,   "SMC Long Exit",   "SMC: CLOSE LONG")
alertcondition(shortExit,  "SMC Short Exit",  "SMC: CLOSE SHORT")

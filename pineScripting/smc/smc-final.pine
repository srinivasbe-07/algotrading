//@version=6
indicator("SMC - Final", overlay=true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ── Display toggles ───────────────────────────────────────────────
showSwings = input.bool(false, "Show raw swing H/L labels")

// ══════════════════════════════════════════════════════════════════
//  PART 1 — Swing Highs & Lows
// ══════════════════════════════════════════════════════════════════

isInside  = high < high[1] and low > low[1]
isBullish = not isInside and close > open
isBearish = not isInside and close < open

pivotLow  = ta.pivotlow(low,  1, 1)
pivotHigh = ta.pivothigh(high, 1, 1)

var float   pendingLow      = na
var int     pendingLowBar   = -1
var int     bullAfterLow    = 0
var float   maxHighSinceLow = na
var label[] bullCountLabels = array.new<label>()

var float   pendingHigh     = na
var int     pendingHighBar  = -1
var int     bearAfterHigh   = 0
var float   minLowSinceHigh = na
var label[] bearCountLabels = array.new<label>()

var int     maxSwings       = 5
var float[] swingHighPrices = array.new<float>()
var int[]   swingHighBars   = array.new<int>()
var float[] swingLowPrices  = array.new<float>()
var int[]   swingLowBars    = array.new<int>()

// Minor (raw) pivots — used by Part 4 for liquidity-grab detection
var int     maxMinor        = 10
var float[] minorHighPrices = array.new<float>()
var int[]   minorHighBars   = array.new<int>()
var float[] minorLowPrices  = array.new<float>()
var int[]   minorLowBars    = array.new<int>()

var bool swingLowJustConfirmed  = false
var bool swingHighJustConfirmed = false
swingLowJustConfirmed  := false
swingHighJustConfirmed := false

// Store raw minor pivots (last maxMinor) for Part 4 liquidity test
if not na(pivotHigh)
    array.unshift(minorHighPrices, pivotHigh)
    array.unshift(minorHighBars,   bar_index[1])
    if array.size(minorHighPrices) > maxMinor
        array.pop(minorHighPrices)
        array.pop(minorHighBars)
if not na(pivotLow)
    array.unshift(minorLowPrices, pivotLow)
    array.unshift(minorLowBars,   bar_index[1])
    if array.size(minorLowPrices) > maxMinor
        array.pop(minorLowPrices)
        array.pop(minorLowBars)

if not na(pendingLow) and close < pendingLow
    for lbl in bullCountLabels
        label.delete(lbl)
    array.clear(bullCountLabels)
    pendingLow      := na
    pendingLowBar   := -1
    bullAfterLow    := 0
    maxHighSinceLow := na

if not na(pendingHigh) and close > pendingHigh
    for lbl in bearCountLabels
        label.delete(lbl)
    array.clear(bearCountLabels)
    pendingHigh     := na
    pendingHighBar  := -1
    bearAfterHigh   := 0
    minLowSinceHigh := na

if not na(pivotLow) and (na(pendingLow) or pivotLow < pendingLow)
    if not na(pendingLow)
        for lbl in bullCountLabels
            label.delete(lbl)
        array.clear(bullCountLabels)
    pendingLow      := pivotLow
    pendingLowBar   := bar_index[1]
    maxHighSinceLow := high[1]
    bullAfterLow    := 0
    if close[1] > open[1]
        bullAfterLow := 1

if not na(pivotHigh) and (na(pendingHigh) or pivotHigh > pendingHigh)
    if not na(pendingHigh)
        for lbl in bearCountLabels
            label.delete(lbl)
        array.clear(bearCountLabels)
    pendingHigh     := pivotHigh
    pendingHighBar  := bar_index[1]
    minLowSinceHigh := low[1]
    bearAfterHigh   := 0
    if close[1] < open[1]
        bearAfterHigh := 1

if not na(pendingLow)
    if isBullish and close > maxHighSinceLow
        bullAfterLow    += 1
        maxHighSinceLow := high
        if bullAfterLow >= 3
            if showSwings
                label.new(pendingLowBar, pendingLow, "L",
                          color=color.new(color.white,100), textcolor=color.red,
                          size=size.normal, style=label.style_none, yloc=yloc.belowbar)
            array.unshift(swingLowPrices, pendingLow)
            array.unshift(swingLowBars,   pendingLowBar)
            if array.size(swingLowPrices) > maxSwings
                array.pop(swingLowPrices)
                array.pop(swingLowBars)
            array.clear(bullCountLabels)
            swingLowJustConfirmed := true
            pendingLow      := na
            pendingLowBar   := -1
            bullAfterLow    := 0
            maxHighSinceLow := na
    else
        maxHighSinceLow := math.max(maxHighSinceLow, high)

if not na(pendingHigh)
    if isBearish and close < minLowSinceHigh
        bearAfterHigh   += 1
        minLowSinceHigh := low
        if bearAfterHigh >= 3
            if showSwings
                label.new(pendingHighBar, pendingHigh, "H",
                          color=color.new(color.white,100), textcolor=color.green,
                          size=size.normal, style=label.style_none, yloc=yloc.abovebar)
            array.unshift(swingHighPrices, pendingHigh)
            array.unshift(swingHighBars,   pendingHighBar)
            if array.size(swingHighPrices) > maxSwings
                array.pop(swingHighPrices)
                array.pop(swingHighBars)
            array.clear(bearCountLabels)
            swingHighJustConfirmed := true
            pendingHigh     := na
            pendingHighBar  := -1
            bearAfterHigh   := 0
            minLowSinceHigh := na
    else
        minLowSinceHigh := math.min(minLowSinceHigh, low)

// ══════════════════════════════════════════════════════════════════
//  PART 2 — Market Structure (BOS / CHoCH)
// ══════════════════════════════════════════════════════════════════

// ── Inputs ────────────────────────────────────────────────────────
colBOS       = input.color(color.blue,  "BOS label",                       group = "Structure")
colUp        = input.color(color.green, "Bullish level / CHoCH",           group = "Structure")
colDown      = input.color(color.red,   "Bearish level / CHoCH",           group = "Structure")
showStructHL = input.bool(true, "Show structure H/L labels",               group = "Structure")
showTrendBg  = input.bool(true, "Trend background (green up / red down)",   group = "Structure")

// ── State ─────────────────────────────────────────────────────────
var string trend             = "none"
var float  refHigh           = na
var float  refLow            = na
var int    refHighBar        = -1
var int    refLowBar         = -1
var int    eventBar          = -1
var bool   waitingForRefHigh = false
var bool   waitingForRefLow  = false
var label  refHighLbl        = na
var label  refLowLbl         = na
var int    obBaseBar         = -1   // leg base bar captured for Part 4 OB

// Per-bar structure events (used by Part 7 — kept for clarity / future use)
bool bullCHoCH = false
bool bearCHoCH = false

// ── Initialize trend from most recent confirmed swing ─────────────
if trend == "none" and array.size(swingHighPrices) > 0 and array.size(swingLowPrices) > 0
    refHigh    := array.get(swingHighPrices, 0)
    refHighBar := array.get(swingHighBars,   0)
    refLow     := array.get(swingLowPrices,  0)
    refLowBar  := array.get(swingLowBars,    0)
    trend      := refHighBar > refLowBar ? "up" : "down"
    if showStructHL
        refHighLbl := label.new(refHighBar, refHigh, "H", color = color.new(color.white, 100), textcolor = colUp, size = size.small, style = label.style_none, yloc = yloc.abovebar)
        refLowLbl  := label.new(refLowBar,  refLow,  "L", color = color.new(color.white, 100), textcolor = colDown, size = size.small, style = label.style_none, yloc = yloc.belowbar)

// ── Wait for Golden Rule confirmation of the pending side ─────────
if waitingForRefHigh and swingHighJustConfirmed and array.size(swingHighBars) > 0 and array.get(swingHighBars, 0) > eventBar
    refHigh           := array.get(swingHighPrices, 0)
    refHighBar        := array.get(swingHighBars,   0)
    waitingForRefHigh := false
    if showStructHL
        refHighLbl := label.new(refHighBar, refHigh, "H", color = color.new(color.white, 100), textcolor = colUp, size = size.small, style = label.style_none, yloc = yloc.abovebar)

if waitingForRefLow and swingLowJustConfirmed and array.size(swingLowBars) > 0 and array.get(swingLowBars, 0) > eventBar
    refLow           := array.get(swingLowPrices, 0)
    refLowBar        := array.get(swingLowBars,   0)
    waitingForRefLow := false
    if showStructHL
        refLowLbl := label.new(refLowBar, refLow, "L", color = color.new(color.white, 100), textcolor = colDown, size = size.small, style = label.style_none, yloc = yloc.belowbar)

// ── BOS / CHoCH Detection ────────────────────────────────────────
bool   eventFired = false
bool   goingUp    = false
string eventType  = ""

if trend != "none"
    if not na(refHigh) and close > refHigh
        eventFired := true
        goingUp    := true
        eventType  := trend == "up" ? "BOS" : "CHoCH"

    if not na(refLow) and close < refLow
        eventFired := true
        goingUp    := false
        eventType  := trend == "down" ? "BOS" : "CHoCH"

// ── Process Event ────────────────────────────────────────────────
if eventFired
    col          = eventType == "BOS" ? colBOS : (goingUp ? colUp : colDown)
    float lvl    = goingUp ? refHigh : refLow
    int   lvlBar = goingUp ? refHighBar : refLowBar
    int   midBar = int(math.avg(lvlBar, bar_index))

    line.new(lvlBar, lvl, bar_index, lvl, color = col, width = 2, style = line.style_dotted)
    label.new(midBar, lvl, eventType,
              color     = color.new(color.white, 100),
              textcolor = col,
              size      = size.small,
              style     = label.style_none)

    eventBar := bar_index

    if eventType == "CHoCH"
        bullCHoCH := goingUp
        bearCHoCH := not goingUp

    if goingUp
        trend := "up"
        float scanLow    = low
        int   scanLowBar = bar_index
        for i = 0 to bar_index - refHighBar
            if low[i] < scanLow
                scanLow    := low[i]
                scanLowBar := bar_index - i
        refLow    := scanLow
        refLowBar := scanLowBar
        obBaseBar := scanLowBar
        if showStructHL
            refLowLbl := label.new(refLowBar, refLow, "L", color = color.new(color.white, 100), textcolor = colDown, size = size.small, style = label.style_none, yloc = yloc.belowbar)
        refHigh           := na
        refHighBar        := -1
        refHighLbl        := na
        waitingForRefHigh := true
        waitingForRefLow  := false
    else
        trend := "down"
        float scanHigh    = high
        int   scanHighBar = bar_index
        for i = 0 to bar_index - refLowBar
            if high[i] > scanHigh
                scanHigh    := high[i]
                scanHighBar := bar_index - i
        refHigh    := scanHigh
        refHighBar := scanHighBar
        obBaseBar  := scanHighBar
        if showStructHL
            refHighLbl := label.new(refHighBar, refHigh, "H", color = color.new(color.white, 100), textcolor = colUp, size = size.small, style = label.style_none, yloc = yloc.abovebar)
        refLow            := na
        refLowBar         := -1
        refLowLbl         := na
        waitingForRefLow  := true
        waitingForRefHigh := false

// ── Trend background ──────────────────────────────────────────────
bgcolor(showTrendBg ? (trend == "up" ? color.new(colUp, 92) : trend == "down" ? color.new(colDown, 92) : na) : na)

// ══════════════════════════════════════════════════════════════════
//  SHARED — LuxAlgo volatility model (parsedHigh / parsedLow)
//  Used by Order Blocks; high-volatility bars use the opposite wick.
// ══════════════════════════════════════════════════════════════════
atrMeasure        = ta.atr(200)

// ══════════════════════════════════════════════════════════════════
//  PART 4 — Order Blocks (LuxAlgo style)
//  • One OB stored per structure break, anchored to the leg's volatility
//    -adjusted extreme candle (LuxAlgo storeOrdeBlock min/max selection).
//  • Box extends right; removed on mitigation (LuxAlgo deleteOrderBlocks).
// ══════════════════════════════════════════════════════════════════
grpOB        = "Order Blocks"
showOB       = input.bool(true,    "Show order blocks",                                 group = grpOB)
obCount      = input.int(5,        "Order blocks to show",  minval = 1, maxval = 20,    group = grpOB)
obFilter     = input.string("Atr", "Order block filter",    options = ["Atr", "Cumulative Mean Range"], group = grpOB)
obMitigation = input.string("High/Low", "Order block mitigation", options = ["Close", "High/Low"],      group = grpOB)
colBullOB    = input.color(color.new(#1848cc, 80), "Bullish OB", group = grpOB)
colBearOB    = input.color(color.new(#b22833, 80), "Bearish OB", group = grpOB)

volatilityMeasure = obFilter == "Atr" ? atrMeasure : ta.cum(ta.tr) / bar_index

// @type   one tracked order block
type ob
    float top
    float bottom
    int   bias          // 1 = bullish, -1 = bearish
    box   bx

var ob[] obs = array.new<ob>()

// On each structure break, store ONE OB at the leg's parsed extreme candle
if eventFired and showOB and obBaseBar >= 0
    int   baseOff   = bar_index - obBaseBar
    bool  volBar    = (high[baseOff] - low[baseOff]) >= 2 * volatilityMeasure[baseOff]
    float obTop     = volBar ? low[baseOff]  : high[baseOff]   // LuxAlgo parsedHigh
    float obBot     = volBar ? high[baseOff] : low[baseOff]    // LuxAlgo parsedLow
    color obCol     = goingUp ? colBullOB : colBearOB
    box   obBx      = box.new(obBaseBar, obTop, bar_index, obBot, border_color = obCol, bgcolor = obCol)
    array.unshift(obs, ob.new(obTop, obBot, goingUp ? 1 : -1, obBx))
    while array.size(obs) > obCount
        old = array.pop(obs)
        box.delete(old.bx)

// ── OB extend + mitigation (LuxAlgo removal) ──
bearMitSrc = obMitigation == "Close" ? close : high
bullMitSrc = obMitigation == "Close" ? close : low
if array.size(obs) > 0
    for i = array.size(obs) - 1 to 0
        o = array.get(obs, i)
        box.set_right(o.bx, bar_index)
        bool mit = o.bias == -1 ? bearMitSrc > o.top : bullMitSrc < o.bottom
        if mit
            box.delete(o.bx)
            array.remove(obs, i)

// ══════════════════════════════════════════════════════════════════
//  PART 3 — Fair Value Gaps (LuxAlgo style)   (second entry trigger)
//  • 3-candle gap with auto volatility threshold filter.
//  • Two stacked boxes split at the midpoint (LuxAlgo look).
//  • Removed on mitigation (LuxAlgo deleteFairValueGaps).
// ══════════════════════════════════════════════════════════════════
grpFVG     = "Fair Value Gaps"
showFVG    = input.bool(true, "Show FVG",                       group = grpFVG)
fvgAuto    = input.bool(true, "Auto threshold",                 group = grpFVG)
fvgExtend  = input.int(10,    "Extend FVG (bars)", minval = 0,  group = grpFVG)
colFvgBull = input.color(color.new(#00ff68, 70), "Bullish FVG", group = grpFVG)
colFvgBear = input.color(color.new(#ff0008, 70), "Bearish FVG", group = grpFVG)

// @type   one tracked fair value gap.  `bottom` = the far protective edge.
type fvg
    float top
    float bottom
    int   bias          // 1 = bullish, -1 = bearish
    box   bx1
    box   bx2

var fvg[] fvgs = array.new<fvg>()

delta        = (close[1] - open[1]) / (open[1] * 100)
fvgThreshold = fvgAuto ? ta.cum(math.abs(delta)) / bar_index * 2 : 0.0
bullFvg      = low  > high[2] and close[1] > high[2] and  delta > fvgThreshold
bearFvg      = high < low[2]  and close[1] < low[2]  and -delta > fvgThreshold

if showFVG and bullFvg
    float t = low                       // upper edge
    float b = high[2]                   // lower edge (far edge for a long)
    float m = math.avg(t, b)
    box   b1 = box.new(bar_index - 1, t, bar_index + fvgExtend, m, border_color = na, bgcolor = colFvgBull)
    box   b2 = box.new(bar_index - 1, m, bar_index + fvgExtend, b, border_color = na, bgcolor = colFvgBull)
    array.unshift(fvgs, fvg.new(t, b, 1, b1, b2))
    while array.size(fvgs) > 20
        old = array.pop(fvgs)
        box.delete(old.bx1)
        box.delete(old.bx2)
if showFVG and bearFvg
    float t = high                      // lower edge
    float b = low[2]                    // upper edge (far edge for a short)
    float m = math.avg(t, b)
    box   b1 = box.new(bar_index - 1, t, bar_index + fvgExtend, m, border_color = na, bgcolor = colFvgBear)
    box   b2 = box.new(bar_index - 1, m, bar_index + fvgExtend, b, border_color = na, bgcolor = colFvgBear)
    array.unshift(fvgs, fvg.new(t, b, -1, b1, b2))
    while array.size(fvgs) > 20
        old = array.pop(fvgs)
        box.delete(old.bx1)
        box.delete(old.bx2)

// ── FVG mitigation (LuxAlgo removal) ──
if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        f = array.get(fvgs, i)
        bool mit = f.bias == 1 ? low < f.bottom : high > f.top
        if mit
            box.delete(f.bx1)
            box.delete(f.bx2)
            array.remove(fvgs, i)

// ══════════════════════════════════════════════════════════════════
//  PART 5 — Liquidity (LuxAlgo style): EQH/EQL + Strong/Weak High & Low
// ══════════════════════════════════════════════════════════════════
grpLiq   = "Liquidity"
showEqHL = input.bool(true,  "Show EQH / EQL",               group = grpLiq)
eqLen    = input.int(3,      "EQH/EQL bars", minval = 1,     group = grpLiq)
eqThresh = input.float(0.1,  "EQH/EQL threshold", minval = 0, maxval = 0.5, step = 0.1, group = grpLiq)
showSWHL = input.bool(true,  "Show strong / weak high & low", group = grpLiq)

// ── EQH / EQL ──
phEq = ta.pivothigh(eqLen, eqLen)
plEq = ta.pivotlow(eqLen, eqLen)
var float lastEqHigh    = na
var int   lastEqHighBar = na
var float lastEqLow     = na
var int   lastEqLowBar  = na
if showEqHL and not na(phEq)
    if not na(lastEqHigh) and math.abs(phEq - lastEqHigh) < eqThresh * atrMeasure
        line.new(lastEqHighBar, lastEqHigh, bar_index - eqLen, phEq, color = colDown, style = line.style_dotted)
        label.new(int(math.avg(lastEqHighBar, bar_index - eqLen)), phEq, "EQH", color = color.new(color.white, 100), textcolor = colDown, style = label.style_label_down, size = size.tiny)
    lastEqHigh    := phEq
    lastEqHighBar := bar_index - eqLen
if showEqHL and not na(plEq)
    if not na(lastEqLow) and math.abs(plEq - lastEqLow) < eqThresh * atrMeasure
        line.new(lastEqLowBar, lastEqLow, bar_index - eqLen, plEq, color = colUp, style = line.style_dotted)
        label.new(int(math.avg(lastEqLowBar, bar_index - eqLen)), plEq, "EQL", color = color.new(color.white, 100), textcolor = colUp, style = label.style_label_up, size = size.tiny)
    lastEqLow    := plEq
    lastEqLowBar := bar_index - eqLen

// ── Trailing extremes (reset to confirmed swing, then ratchet) ──
var float trTop    = na
var int   trTopBar = na
var float trBot    = na
var int   trBotBar = na
if swingHighJustConfirmed and array.size(swingHighPrices) > 0
    trTop    := array.get(swingHighPrices, 0)
    trTopBar := array.get(swingHighBars,   0)
if swingLowJustConfirmed and array.size(swingLowPrices) > 0
    trBot    := array.get(swingLowPrices, 0)
    trBotBar := array.get(swingLowBars,   0)
if na(trTop) or high > trTop
    trTop    := high
    trTopBar := bar_index
if na(trBot) or low < trBot
    trBot    := low
    trBotBar := bar_index

// ── Strong / Weak High & Low (redrawn on the last bar) ──
var line  swTopLine = na
var label swTopLbl  = na
var line  swBotLine = na
var label swBotLbl  = na
if showSWHL and barstate.islast and not na(trTop) and not na(trBot)
    line.delete(swTopLine)
    label.delete(swTopLbl)
    line.delete(swBotLine)
    label.delete(swBotLbl)
    int rightBar = bar_index + 10
    swTopLine := line.new(trTopBar, trTop, rightBar, trTop, color = colDown)
    swTopLbl  := label.new(rightBar, trTop, trend == "down" ? "Strong High" : "Weak High", color = color.new(color.white, 100), textcolor = colDown, style = label.style_label_down, size = size.tiny)
    swBotLine := line.new(trBotBar, trBot, rightBar, trBot, color = colUp)
    swBotLbl  := label.new(rightBar, trBot, trend == "up" ? "Strong Low" : "Weak Low", color = color.new(color.white, 100), textcolor = colUp, style = label.style_label_up, size = size.tiny)

// ══════════════════════════════════════════════════════════════════
//  PART 6 — Premium / Discount Zones (LuxAlgo style) from trailing extremes
//  + frozen-range equilibrium used by the Part 7 confluence filter.
// ══════════════════════════════════════════════════════════════════
grpPD   = "Premium / Discount Zones"
showPD  = input.bool(false, "Show premium / discount zones",       group = grpPD)
colPrem = input.color(color.new(color.red,  80), "Premium Zone",     group = grpPD)
colEqui = input.color(color.new(color.gray, 80), "Equilibrium Zone", group = grpPD)
colDisc = input.color(color.new(color.green,80), "Discount Zone",    group = grpPD)

var box   premBox = na
var box   equiBox = na
var box   discBox = na
var label premLbl = na
var label equiLbl = na
var label discLbl = na
if showPD and barstate.islast and not na(trTop) and not na(trBot)
    box.delete(premBox)
    box.delete(equiBox)
    box.delete(discBox)
    label.delete(premLbl)
    label.delete(equiLbl)
    label.delete(discLbl)
    int   leftBar = math.min(trTopBar, trBotBar)
    float eqLevel = math.avg(trTop, trBot)
    premBox := box.new(leftBar, trTop,                       bar_index, 0.95 * trTop + 0.05 * trBot, bgcolor = colPrem, border_color = na)
    equiBox := box.new(leftBar, 0.525 * trTop + 0.475 * trBot, bar_index, 0.525 * trBot + 0.475 * trTop, bgcolor = colEqui, border_color = na)
    discBox := box.new(leftBar, 0.95 * trBot + 0.05 * trTop, bar_index, trBot,                       bgcolor = colDisc, border_color = na)
    premLbl := label.new(bar_index, trTop,    "Premium",     color = color.new(color.white, 100), textcolor = color.red,  style = label.style_label_down, size = size.small)
    equiLbl := label.new(bar_index, eqLevel,  "Equilibrium", color = color.new(color.white, 100), textcolor = color.gray, style = label.style_label_left, size = size.small)
    discLbl := label.new(bar_index, trBot,    "Discount",    color = color.new(color.white, 100), textcolor = color.green,style = label.style_label_up,   size = size.small)

// ══════════════════════════════════════════════════════════════════
//  Highs & Lows MTF (LuxAlgo style) — previous Day / Week / Month H & L
// ══════════════════════════════════════════════════════════════════
grpMTF = "Highs & Lows MTF"
showD  = input.bool(false, "Daily",   group = grpMTF, inline = "d")
showW  = input.bool(false, "Weekly",  group = grpMTF, inline = "w")
showM  = input.bool(false, "Monthly", group = grpMTF, inline = "m")
colMTF = input.color(color.new(#2157f3, 0), "Levels color", group = grpMTF)

[dH, dL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[wH, wL] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[mH, mL] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)

drawMTF(bool show, float hi, float lo, color c, string tag) =>
    var line  hLine = na
    var line  lLine = na
    var label hLbl  = na
    var label lLbl  = na
    if show and barstate.islast
        line.delete(hLine)
        line.delete(lLine)
        label.delete(hLbl)
        label.delete(lLbl)
        int L = bar_index - 60
        int R = bar_index + 20
        hLine := line.new(L, hi, R, hi, color = c, style = line.style_solid)
        lLine := line.new(L, lo, R, lo, color = c, style = line.style_solid)
        hLbl  := label.new(R, hi, "P" + tag + "H", color = color.new(color.white, 100), textcolor = c, style = label.style_label_left, size = size.small)
        lLbl  := label.new(R, lo, "P" + tag + "L", color = color.new(color.white, 100), textcolor = c, style = label.style_label_left, size = size.small)

drawMTF(showD, dH, dL, colMTF, "D")
drawMTF(showW, wH, wL, colMTF, "W")
drawMTF(showM, mH, mL, colMTF, "M")


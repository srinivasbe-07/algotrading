//@version=6
indicator("SMC Part 4 - Order Blocks", overlay=true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ── Display toggles ───────────────────────────────────────────────
showSwings = input.bool(false, "Show raw swing H/L labels")

// ══════════════════════════════════════════════════════════════════
//  PART 1 — Swing Highs & Lows
// ══════════════════════════════════════════════════════════════════

isInside  = high < high[1] and low > low[1]
isBullish = not isInside and close > open
isBearish = not isInside and close < open

pivotLow  = ta.pivotlow(low,  1, 1)
pivotHigh = ta.pivothigh(high, 1, 1)

var float   pendingLow      = na
var int     pendingLowBar   = -1
var int     bullAfterLow    = 0
var float   maxHighSinceLow = na
var label[] bullCountLabels = array.new<label>()

var float   pendingHigh     = na
var int     pendingHighBar  = -1
var int     bearAfterHigh   = 0
var float   minLowSinceHigh = na
var label[] bearCountLabels = array.new<label>()

var int     maxSwings       = 5
var float[] swingHighPrices = array.new<float>()
var int[]   swingHighBars   = array.new<int>()
var float[] swingLowPrices  = array.new<float>()
var int[]   swingLowBars    = array.new<int>()

// Minor (raw) pivots — used by Part 4 for liquidity-grab detection
var int     maxMinor        = 10
var float[] minorHighPrices = array.new<float>()
var int[]   minorHighBars   = array.new<int>()
var float[] minorLowPrices  = array.new<float>()
var int[]   minorLowBars    = array.new<int>()

var bool swingLowJustConfirmed  = false
var bool swingHighJustConfirmed = false
swingLowJustConfirmed  := false
swingHighJustConfirmed := false

// Store raw minor pivots (last maxMinor) for Part 4 liquidity test
if not na(pivotHigh)
    array.unshift(minorHighPrices, pivotHigh)
    array.unshift(minorHighBars,   bar_index[1])
    if array.size(minorHighPrices) > maxMinor
        array.pop(minorHighPrices)
        array.pop(minorHighBars)
if not na(pivotLow)
    array.unshift(minorLowPrices, pivotLow)
    array.unshift(minorLowBars,   bar_index[1])
    if array.size(minorLowPrices) > maxMinor
        array.pop(minorLowPrices)
        array.pop(minorLowBars)

if not na(pendingLow) and close < pendingLow
    for lbl in bullCountLabels
        label.delete(lbl)
    array.clear(bullCountLabels)
    pendingLow      := na
    pendingLowBar   := -1
    bullAfterLow    := 0
    maxHighSinceLow := na

if not na(pendingHigh) and close > pendingHigh
    for lbl in bearCountLabels
        label.delete(lbl)
    array.clear(bearCountLabels)
    pendingHigh     := na
    pendingHighBar  := -1
    bearAfterHigh   := 0
    minLowSinceHigh := na

if not na(pivotLow) and (na(pendingLow) or pivotLow < pendingLow)
    if not na(pendingLow)
        for lbl in bullCountLabels
            label.delete(lbl)
        array.clear(bullCountLabels)
    pendingLow      := pivotLow
    pendingLowBar   := bar_index[1]
    maxHighSinceLow := high[1]
    bullAfterLow    := 0
    if close[1] > open[1]
        bullAfterLow := 1

if not na(pivotHigh) and (na(pendingHigh) or pivotHigh > pendingHigh)
    if not na(pendingHigh)
        for lbl in bearCountLabels
            label.delete(lbl)
        array.clear(bearCountLabels)
    pendingHigh     := pivotHigh
    pendingHighBar  := bar_index[1]
    minLowSinceHigh := low[1]
    bearAfterHigh   := 0
    if close[1] < open[1]
        bearAfterHigh := 1

if not na(pendingLow)
    if isBullish and close > maxHighSinceLow
        bullAfterLow    += 1
        maxHighSinceLow := high
        if bullAfterLow >= 3
            if showSwings
                label.new(pendingLowBar, pendingLow, "L",
                          color=color.new(color.white,100), textcolor=color.red,
                          size=size.normal, style=label.style_none, yloc=yloc.belowbar)
            array.unshift(swingLowPrices, pendingLow)
            array.unshift(swingLowBars,   pendingLowBar)
            if array.size(swingLowPrices) > maxSwings
                array.pop(swingLowPrices)
                array.pop(swingLowBars)
            array.clear(bullCountLabels)
            swingLowJustConfirmed := true
            pendingLow      := na
            pendingLowBar   := -1
            bullAfterLow    := 0
            maxHighSinceLow := na
    else
        maxHighSinceLow := math.max(maxHighSinceLow, high)

if not na(pendingHigh)
    if isBearish and close < minLowSinceHigh
        bearAfterHigh   += 1
        minLowSinceHigh := low
        if bearAfterHigh >= 3
            if showSwings
                label.new(pendingHighBar, pendingHigh, "H",
                          color=color.new(color.white,100), textcolor=color.green,
                          size=size.normal, style=label.style_none, yloc=yloc.abovebar)
            array.unshift(swingHighPrices, pendingHigh)
            array.unshift(swingHighBars,   pendingHighBar)
            if array.size(swingHighPrices) > maxSwings
                array.pop(swingHighPrices)
                array.pop(swingHighBars)
            array.clear(bearCountLabels)
            swingHighJustConfirmed := true
            pendingHigh     := na
            pendingHighBar  := -1
            bearAfterHigh   := 0
            minLowSinceHigh := na
    else
        minLowSinceHigh := math.min(minLowSinceHigh, low)

// ══════════════════════════════════════════════════════════════════
//  PART 2 — Market Structure (BOS / CHoCH)
// ══════════════════════════════════════════════════════════════════

// ── Inputs ────────────────────────────────────────────────────────
colBOS       = input.color(color.blue,  "BOS label")
colUp        = input.color(color.green, "Bullish level / CHoCH")
colDown      = input.color(color.red,   "Bearish level / CHoCH")
showStructHL = input.bool(true, "Show structure H/L labels")
showTrendBg  = input.bool(true, "Trend background (green up / red down)")

// ── State ─────────────────────────────────────────────────────────
var string trend             = "none"
var float  refHigh           = na
var float  refLow            = na
var int    refHighBar        = -1
var int    refLowBar         = -1
var int    eventBar          = -1
var bool   waitingForRefHigh = false
var bool   waitingForRefLow  = false
var label  refHighLbl        = na
var label  refLowLbl         = na
var int    obBaseBar         = -1   // leg base bar captured for Part 4 OB

// ── Initialize: once both confirmed H and L exist, set trend from
//   which swing is most recent — no need to wait for a price break ─
if trend == "none" and array.size(swingHighPrices) > 0 and array.size(swingLowPrices) > 0
    refHigh    := array.get(swingHighPrices, 0)
    refHighBar := array.get(swingHighBars,   0)
    refLow     := array.get(swingLowPrices,  0)
    refLowBar  := array.get(swingLowBars,    0)
    // Most recent swing tells us current structure direction
    trend      := refHighBar > refLowBar ? "up" : "down"
    if showStructHL
        refHighLbl := label.new(refHighBar, refHigh, "H", color = color.new(color.white, 100), textcolor = colUp, size = size.small, style = label.style_none, yloc = yloc.abovebar)
        refLowLbl  := label.new(refLowBar,  refLow,  "L", color = color.new(color.white, 100), textcolor = colDown, size = size.small, style = label.style_none, yloc = yloc.belowbar)

// ── Wait for Golden Rule confirmation of the pending side ─────────
//   The "other" side after an event is left na until Part 1 confirms
//   the next swing in that direction past the event bar.
if waitingForRefHigh and swingHighJustConfirmed and array.size(swingHighBars) > 0 and array.get(swingHighBars, 0) > eventBar
    refHigh           := array.get(swingHighPrices, 0)
    refHighBar        := array.get(swingHighBars,   0)
    waitingForRefHigh := false
    if showStructHL
        refHighLbl := label.new(refHighBar, refHigh, "H", color = color.new(color.white, 100), textcolor = colUp, size = size.small, style = label.style_none, yloc = yloc.abovebar)

if waitingForRefLow and swingLowJustConfirmed and array.size(swingLowBars) > 0 and array.get(swingLowBars, 0) > eventBar
    refLow           := array.get(swingLowPrices, 0)
    refLowBar        := array.get(swingLowBars,   0)
    waitingForRefLow := false
    if showStructHL
        refLowLbl := label.new(refLowBar, refLow, "L", color = color.new(color.white, 100), textcolor = colDown, size = size.small, style = label.style_none, yloc = yloc.belowbar)

// ── BOS / CHoCH Detection ────────────────────────────────────────

bool   eventFired = false
bool   goingUp    = false
string eventType  = ""

if trend != "none"
    if not na(refHigh) and close > refHigh
        eventFired := true
        goingUp    := true
        eventType  := trend == "up" ? "BOS" : "CHoCH"

    if not na(refLow) and close < refLow
        eventFired := true
        goingUp    := false
        eventType  := trend == "down" ? "BOS" : "CHoCH"

// ── Process Event ────────────────────────────────────────────────
//   The ONLY place a line is drawn: one per BOS/CHoCH, from the broken
//   level's origin bar to the break bar. Two line types only: BOS, CHoCH.
if eventFired
    col          = eventType == "BOS" ? colBOS : (goingUp ? colUp : colDown)
    float lvl    = goingUp ? refHigh : refLow
    int   lvlBar = goingUp ? refHighBar : refLowBar
    int   midBar = int(math.avg(lvlBar, bar_index))   // center of the broken line

    line.new(lvlBar, lvl, bar_index, lvl, color = col, width = 2, style = line.style_dotted)
    label.new(midBar, lvl, eventType,
              color     = color.new(color.white, 100),
              textcolor = col,
              size      = size.small,
              style     = label.style_none)

    eventBar := bar_index

    if goingUp
        trend := "up"
        // Immediate side: new refLow = lowest low scanned from refHighBar → event bar
        float scanLow    = low
        int   scanLowBar = bar_index
        for i = 0 to bar_index - refHighBar
            if low[i] < scanLow
                scanLow    := low[i]
                scanLowBar := bar_index - i
        refLow    := scanLow
        refLowBar := scanLowBar
        obBaseBar := scanLowBar          // leg bottom = bullish OB base
        if showStructHL
            refLowLbl := label.new(refLowBar, refLow, "L", color = color.new(color.white, 100), textcolor = colDown, size = size.small, style = label.style_none, yloc = yloc.belowbar)
        // Waiting side: refHigh from the next confirmed swing high (label kept as history)
        refHigh           := na
        refHighBar        := -1
        refHighLbl        := na
        waitingForRefHigh := true
        waitingForRefLow  := false
    else
        trend := "down"
        // Immediate side: new refHigh = highest high scanned from refLowBar → event bar
        float scanHigh    = high
        int   scanHighBar = bar_index
        for i = 0 to bar_index - refLowBar
            if high[i] > scanHigh
                scanHigh    := high[i]
                scanHighBar := bar_index - i
        refHigh    := scanHigh
        refHighBar := scanHighBar
        obBaseBar  := scanHighBar         // leg top = bearish OB base
        if showStructHL
            refHighLbl := label.new(refHighBar, refHigh, "H", color = color.new(color.white, 100), textcolor = colUp, size = size.small, style = label.style_none, yloc = yloc.abovebar)
        // Waiting side: refLow from the next confirmed swing low (label kept as history)
        refLow            := na
        refLowBar         := -1
        refLowLbl         := na
        waitingForRefLow  := true
        waitingForRefHigh := false

// ── Trend background ──────────────────────────────────────────────
bgcolor(showTrendBg ? (trend == "up" ? color.new(colUp, 92) : trend == "down" ? color.new(colDown, 92) : na) : na)

// ══════════════════════════════════════════════════════════════════
//  PART 4 — Order Blocks (OB)
//
//  Trigger: a BOS or CHoCH fires (Part 2) → look back to the base
//  candle of the leg that caused the break (same candle LuxAlgo picks).
//    Bullish OB base = lowest-low candle of the leg (launch point up)
//    Bearish OB base = highest-high candle of the leg (launch point down)
//  Zone = base candle full range (high → low).
//
//  Quality tiers:
//    A+ OB      = base swept liquidity (took a prior swing low/high)
//                 AND the leg left an FVG.  Shown by default, bright.
//    Regular OB = break OB missing one/both.  Hidden behind a toggle.
//
//  States:  fresh → tapped (first touch = entry, outlined, kept)
//                 → broken (body closes through far edge = dead).
//  Broken OBs greyed; "Hide broken OBs" toggle removes them.
// ══════════════════════════════════════════════════════════════════

// ── Inputs ────────────────────────────────────────────────────────
showAplus   = input.bool(true,  "Show A+ order blocks",       group = "Order Blocks")
showRegular = input.bool(true,  "Show regular order blocks",  group = "Order Blocks")
colBull     = input.color(color.new(color.blue,   80), "Bullish OB fill",   group = "Order Blocks")
colBullBrd  = input.color(color.new(color.blue,   30), "Bullish OB border", group = "Order Blocks")
colBear     = input.color(color.new(color.orange, 80), "Bearish OB fill",   group = "Order Blocks")
colBearBrd  = input.color(color.new(color.orange, 30), "Bearish OB border", group = "Order Blocks")
colTap      = input.color(color.orange,               "Tapped outline",     group = "Order Blocks")
colBroken   = input.color(color.new(color.gray, 85),  "Broken OB",          group = "Order Blocks")
maxOBs      = input.int(12, "Max OB boxes",         minval = 1, group = "Order Blocks")
obExtend    = input.int(10, "OB box extend (bars)", minval = 0, group = "Order Blocks")
obLookback  = input.int(50, "OB liquidity search lookback (bars)", minval = 5, group = "Order Blocks")
hideBroken  = input.bool(false, "Hide broken OBs",  group = "Order Blocks")
dbgOB       = input.bool(true,  "DEBUG: outline every break's OB + A+/REG tag + leg FVG", group = "Order Blocks")

// ── Type: one tracked Order Block ─────────────────────────────────
type ob
    float top
    float bottom
    int   bias          // 1 = bullish, -1 = bearish
    bool  aplus
    box   bx
    int   baseBar = -1
    bool  tapped  = false
    bool  broken  = false

var ob[] obs = array.new<ob>()

trimOB() =>
    while array.size(obs) > maxOBs
        old = array.shift(obs)
        box.delete(old.bx)

// Try to build an OB anchored at base bar `b` (a minor pullback). Requires a
// displacement (2-candle gap or 3-candle FVG) between the base and the break.
// Deduped by baseBar. Liquidity sweep → A+, else Regular. Called for every
// recent pullback so the chart carries a STACK of OBs (near + deep fallbacks).
makeOB(int b, bool up) =>
    if b < bar_index and bar_index - b <= obLookback
        int   candOff = bar_index - b
        bool  found   = false
        int   dispOff = -1          // candle right before the displacement
        float ft = na
        float fb = na
        int   fl = -1
        int   fr = -1
        // Displacement nearest the base (scan base → break, take the first)
        for o = candOff - 1 to 0
            if not found
                bool gap2 = up ? high[o + 1] < low[o] : low[o + 1] > high[o]
                bool fvg3 = false
                if o + 2 <= candOff
                    fvg3 := up ? high[o + 2] < low[o] : low[o + 2] > high[o]
                if gap2
                    found   := true
                    dispOff := o + 1
                    ft := up ? low[o] : low[o + 1]
                    fb := up ? high[o + 1] : high[o]
                    fl := bar_index - (o + 1)
                    fr := bar_index - o
                else if fvg3
                    found   := true
                    dispOff := o + 2
                    ft := up ? low[o] : low[o + 2]
                    fb := up ? high[o + 2] : high[o]
                    fl := bar_index - (o + 2)
                    fr := bar_index - o
        if found
            // OB candle = the LAST opposing candle right before the
            // displacement (bullish → last red; bearish → last green).
            //   Search from the pre-displacement candle back through the base
            //   (a few bars OLDER than the pivot too — that's where the last
            //   opposing candle usually sits).
            int obCandOff = dispOff
            for x = dispOff to math.min(bar_index, candOff + 5)
                if (up ? close[x] < open[x] : close[x] > open[x])
                    obCandOff := x
                    break
            int   obBar = bar_index - obCandOff
            float ot    = high[obCandOff]
            float obb   = low[obCandOff]
            // De-clutter: skip if this zone overlaps an existing LIVE
            // same-side OB (keeps one box per price area, not a stack).
            bool overlap = false
            if array.size(obs) > 0
                for i = 0 to array.size(obs) - 1
                    ob ex = array.get(obs, i)
                    if not ex.broken and ex.bias == (up ? 1 : -1) and obb <= ex.top and ex.bottom <= ot
                        overlap := true
                        break
            if not overlap
                bool  liq = false
                if up
                    if array.size(minorLowPrices) > 0
                        for kk = 0 to array.size(minorLowPrices) - 1
                            if array.get(minorLowBars, kk) < obBar
                                liq := obb < array.get(minorLowPrices, kk)
                                break
                else
                    if array.size(minorHighPrices) > 0
                        for kk = 0 to array.size(minorHighPrices) - 1
                            if array.get(minorHighBars, kk) < obBar
                                liq := ot > array.get(minorHighPrices, kk)
                                break
                bool  show = liq ? showAplus : showRegular
                color bc   = show ? (up ? colBull : colBear)       : color(na)
                color brc  = show ? (up ? colBullBrd : colBearBrd) : color(na)
                box   bxx  = box.new(obBar, ot, bar_index + obExtend, obb, border_color = brc, border_width = liq ? 2 : 1, bgcolor = bc)
                array.push(obs, ob.new(ot, obb, up ? 1 : -1, liq, bxx, obBar))
                trimOB()
                if dbgOB
                    box.new(obBar, ot, bar_index, obb, border_color = up ? color.green : color.red, border_width = 1, border_style = line.style_dashed, bgcolor = color(na))
                    box.new(fl, ft, fr, fb, border_color = color.new(color.blue, 0), border_width = 1, bgcolor = color.new(color.blue, 80))
                    string tg = (liq ? "A+" : "REG") + " liq" + (liq ? "✓" : "✗") + " fvg✓"
                    label.new(obBar, up ? obb : ot, tg, color = color.new(color.black, 100), textcolor = liq ? color.green : color.gray, style = up ? label.style_label_up : label.style_label_down, size = size.small)

// ── On a break, (re)build the STACK of OBs at recent pullbacks ─────
//   Each minor pullback (pivot low for bullish / high for bearish) that
//   launched a displacement becomes an OB. Deduped → near + deep fallbacks.
if eventFired
    if goingUp
        if array.size(minorLowBars) > 0
            for k = 0 to array.size(minorLowBars) - 1
                makeOB(array.get(minorLowBars, k), true)
    else
        if array.size(minorHighBars) > 0
            for k = 0 to array.size(minorHighBars) - 1
                makeOB(array.get(minorHighBars, k), false)

// ── State transitions: tap (first touch) → break (close through) ──
if array.size(obs) > 0
    for i = array.size(obs) - 1 to 0
        o = array.get(obs, i)
        if not o.broken
            box.set_right(o.bx, bar_index + obExtend)          // keep extending while live
            // Tap = first time price trades into the zone (entry event for Part 7)
            if not o.tapped and high >= o.bottom and low <= o.top
                o.tapped := true
                box.set_border_color(o.bx, colTap)
                box.set_border_width(o.bx, 2)
            // Break = body closes through the far edge → dead
            bool brk = o.bias == 1 ? close < o.bottom : close > o.top
            if brk
                o.broken := true
                if hideBroken
                    box.delete(o.bx)
                    array.remove(obs, i)
                else
                    box.set_bgcolor(o.bx, colBroken)
                    box.set_border_color(o.bx, color.new(color.gray, 60))
                    box.set_right(o.bx, bar_index)             // freeze at the break bar

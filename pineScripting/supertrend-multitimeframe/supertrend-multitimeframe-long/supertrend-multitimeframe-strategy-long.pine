//@version=6
strategy("Super Trend Multi Time Frame Long", overlay=true, default_qty_type=strategy.fixed,
         pyramiding=0)

atrPeriod = input.int(10,    "ATR Length", minval = 1)
factor    = input.float(3.0, "Factor",     minval = 0.01, step = 0.01)

higherTimeFrame = switch timeframe.period
    "1"  => "3"
    "2"  => "5"
    "3"  => "5"
    "5"  => "15"
    => "60"

[l_supertrend, l_direction] = ta.supertrend(factor, atrPeriod)
l_supertrend := barstate.isfirst ? na : l_supertrend
l_upTrend =    plot(l_direction < 0 ? l_supertrend : na, "Up Trend",   color = color.green, style = plot.style_linebr)
l_downTrend =  plot(l_direction < 0 ? na : l_supertrend, "Down Trend", color = color.red,   style = plot.style_linebr)
l_bodyMiddle = plot(barstate.isfirst ? na : (open + close) / 2, "Body Middle", display = display.none)

fill(l_bodyMiddle, l_upTrend,   title = "Uptrend background",   color = color.new(color.green, 90), fillgaps = false)
fill(l_bodyMiddle, l_downTrend, title = "Downtrend background", color = color.new(color.red,   90), fillgaps = false)

[h_supertrend, h_direction] = request.security(syminfo.tickerid, higherTimeFrame, ta.supertrend(factor, atrPeriod))
h_supertrend := barstate.isfirst ? na : h_supertrend
h_upTrend =    plot(h_direction < 0 ? h_supertrend : na, "Up Trend",   color = color.green, style = plot.style_linebr)
h_downTrend =  plot(h_direction < 0 ? na : h_supertrend, "Down Trend", color = color.red,   style = plot.style_linebr)
h_bodyMiddle = plot(barstate.isfirst ? na : (open + close) / 2, "Body Middle", display = display.none)

fill(h_bodyMiddle, h_upTrend,   title = "Uptrend background",   color = color.new(color.green, 90), fillgaps = false)
fill(h_bodyMiddle, h_downTrend, title = "Downtrend background", color = color.new(color.red,   90), fillgaps = false)

symbol   = syminfo.ticker

isNifty     = str.contains(symbol, 'NIFTY') and not str.contains(symbol, 'BANKNIFTY')
isBankNifty = str.contains(symbol, 'BANKNIFTY')
isSensex    = str.contains(symbol, 'BSX') or str.contains(symbol, 'SENSEX')

quantity = isSensex or isNifty or isBankNifty ? 1 : symbol == 'BTCUSD.P' ? 7 : symbol == 'SOLUSD.P' ? 5 : symbol == 'ETHUSD.P' ? 27 : 0

bigCandleThreshold = isSensex ? 35.0 : 15.0

var int   longC             = 0
var bool  pendingEntry      = false
var float pendingEntryLevel = na

// Exit check first
longExit = longC != 0 and (close < l_supertrend or close < h_supertrend) and barstate.isconfirmed

if longExit
    longC             := 0
    pendingEntry      := false
    pendingEntryLevel := na
    if isNifty
        strategy.close("Long", comment='exit', alert_message='684b964eabc928d036545e4c')
    else if isSensex
        strategy.close("Long", comment='exit', alert_message='684be6b7abc928d03654601b')
    else if isBankNifty
        strategy.close("Long", comment='exit', alert_message='684beb16290d47dc0a8733bb')
    else
        strategy.close("Long")

// Cancel pending if supertrend turns bearish while waiting for pullback
if pendingEntry and (close < l_supertrend or close < h_supertrend)
    pendingEntry      := false
    pendingEntryLevel := na

// Crossover signal on current bar
crossoverSignal = longC == 0 and ((ta.crossover(close, l_supertrend) and close > h_supertrend) or (ta.crossover(close, h_supertrend) and close > l_supertrend)) and barstate.isconfirmed

isBigCandle = (high - low) > bigCandleThreshold

// Big candle: wait for pullback to low + threshold; normal candle: enter immediately
if crossoverSignal
    if isBigCandle
        pendingEntry      := true
        pendingEntryLevel := low + bigCandleThreshold
        label.new(bar_index, pendingEntryLevel, "Wait @ " + str.tostring(math.round(pendingEntryLevel, 2)),
                  color=color.orange, textcolor=color.white, style=label.style_label_up, size=size.small)

// Pending fill fires on bar close when price touched the entry level
pendingFill = pendingEntry and not crossoverSignal and barstate.isconfirmed and low <= pendingEntryLevel
longEntry   = (crossoverSignal and not isBigCandle) or pendingFill

if longEntry
    longC             := 1
    pendingEntry      := false
    pendingEntryLevel := na
    if isNifty
        strategy.entry("Long", strategy.long, qty=quantity, comment='entry', alert_message='684b964eabc928d036545e4c')
    else if isSensex
        strategy.entry("Long", strategy.long, qty=quantity, comment='entry', alert_message='684be6b7abc928d03654601b')
    else if isBankNifty
        strategy.entry("Long", strategy.long, qty=quantity, comment='entry', alert_message='684beb16290d47dc0a8733bb')
    else
        strategy.entry("Long", strategy.long, qty=quantity)

// Plot pending entry level while waiting for pullback
plot(pendingEntry ? pendingEntryLevel : na, "Pending Entry Level", color=color.orange, style=plot.style_linebr, linewidth=2)

// Plot signals
plotshape(longEntry, title="Long Entry", style=shape.arrowup,   location=location.abovebar, color=color.green, text="Long")
plotshape(longExit,  title="Long Exit",  style=shape.arrowdown, location=location.belowbar, color=color.red,   text="Exit Long")
